{
    "_comment": "How the Assets panel shows a file: by extension, '/' for folders, '*' for anything else. Colours name theme colours; text files open in a tab on a double click.",
    "/": {"icon": "folder", "color": "orange"},
    "*": {"icon": "file", "color": "muted"},
    "az": {"icon": "file-code", "color": "blue", "text": true},
    "azon": {"icon": "file-text", "color": "teal", "text": true},
    "pgm": {"icon": "mountain", "color": "green"},
    "azscene": {"icon": "box", "color": "purple"},
    "azlayout": {"icon": "layout-template", "color": "teal", "text": true},
    "aztexture": {"icon": "image", "color": "purple"},
    "aztex": {"icon": "image", "color": "purple"},
    "png": {"icon": "image", "color": "pink"},
    "jpg": {"icon": "image", "color": "pink"},
    "jpeg": {"icon": "image", "color": "pink"},
    "wav": {"icon": "music", "color": "green"},
    "ogg": {"icon": "music", "color": "green"},
    "mp3": {"icon": "music", "color": "green"},
    "md": {"icon": "book-open", "color": "muted", "text": true},
    "txt": {"icon": "file-text", "color": "muted", "text": true}
}
