            "hint": "Soften uneven surfaces"
        },
        {
            "id": "flatten",
            "label": "Flatten",
            "icon": "square",
            "hint": "Level to the height at the start of the stroke"
        },
        {
            "id": "cave",
            "label": "Carve Cave",
            "icon": "mountain",
            "hint": "Subtract a volume at the brush depth"
