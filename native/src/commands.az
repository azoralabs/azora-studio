}

@Command(title: "Rotate Tool", menu: "View", group: 0, order: 2, key: "3", hotkey: "e")
func toolRotate(studio: Studio!, call: Invocation&): Unit {
    studio.roadPlacement = 0
    studio.foliageBrush.mode = 0
    studio.pluginTool = ""
    studio.pluginToolOwner = ""
    studio.pluginHit = .()
