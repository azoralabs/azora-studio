@Command(title: "Scale Tool", menu: "View", group: 0, order: 3, key: "4", hotkey: "r")
func toolScale(studio: Studio!, call: Invocation&): Unit {
    studio.roadPlacement = 0
    studio.foliageBrush.mode = 0
