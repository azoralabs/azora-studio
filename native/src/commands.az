/** Ends the session: the frame loop saves the layout and closes the window. */
@Command(title: "Quit Azora Studio", key: "q")
func studioQuit(studio: Studio!, call: Invocation&) { studio.quitting = true }

@Command(title: "Reset Layout", menu: "Window", group: 0, order: 0)
func windowResetLayout(studio: Studio!, call: Invocation&): Unit {
    studio.resetLayout = true
    studio.message("Layout reset")
}

/** Shows panel [call.text]: its tab when it is open, otherwise a new one. */
@Command
func panelShow(studio: Studio!, call: Invocation&): Unit {
    studio.showPanel = call.text
}

inline fin renderPreferencesFile: String = "rendering.azon"

func loadRenderPreferences(studio: Studio!, home: String) {
    fin overridePath = azsEnvironment("AZORA_STUDIO_PREFERENCES")
    studio.preferencesRoot = if overridePath != "" then overridePath
        else if home != "" then "${home}/Library/Application Support/Azora Studio" else ""
    if studio.preferencesRoot == "" then return
    fin source = readProjectFile(studio.preferencesRoot, renderPreferencesFile)
    if source == "" then return
    fin document = decodeSerialValue(source, serializerOptions()) catch SerialValue.Null
    when document {
        .Object(fields) -> {
            studio.indirectLighting = memberText(fields, "lighting", "photon") != "standard"
            studio.virtualShadows = memberText(fields, "shadows", "virtual") != "computed"
            studio.upscaling = memberText(fields, "upscaling", "native") == "temporal"
        }
        else -> {}
    }
}

func saveRenderPreferences(studio: Studio!) {
    if studio.preferencesRoot == "" then return
    makeFolders(studio.preferencesRoot)
    fin project = azsProjectOpen(studio.preferencesRoot, 0)
    if project == 0 {
        studio.notify("Couldn't open the preferences folder", 3)
        return
    }
    fin lighting = if studio.indirectLighting then "photon" else "standard"
    fin shadows = if studio.virtualShadows then "virtual" else "computed"
    fin upscaling = if studio.upscaling then "temporal" else "native"
    fin buffer = azsBufferNew("{\"lighting\": \"${lighting}\", \"shadows\": \"${shadows}\", \"upscaling\": \"${upscaling}\"}\n")
    fin written = if buffer == 0 then 0 else azsProjectWrite(project, renderPreferencesFile, buffer)
    if buffer != 0 then azsBufferClose(buffer)
    azsProjectClose(project)
    if written == 0 then studio.notify("Couldn't save rendering preferences", 3)
}

@Command
func preferencesShow(studio: Studio!, call: Invocation&) { studio.showPanel = "PreferencesPanel" }

@Command
func preferencesLighting(studio: Studio!, call: Invocation&) {
    studio.indirectLighting = call.text == "photon"
    saveRenderPreferences(studio)
    studio.changed()
}

@Command
func preferencesShadows(studio: Studio!, call: Invocation&) {
    studio.virtualShadows = call.text == "virtual"
    saveRenderPreferences(studio)
    studio.changed()
}

@Command
func preferencesUpscaling(studio: Studio!, call: Invocation&) {
    studio.upscaling = call.text == "temporal"
    saveRenderPreferences(studio)
    studio.changed()
}

@Command
func preferencesRecompute(studio: Studio!, call: Invocation&) {
    studio.recomputeShadows = true
    studio.showPanel = "ScenePanel"
}

// ── Scene tree ──────────────────────────────────────────────────────────

@Command
func sceneSelect(studio: Studio!, call: Invocation&): Unit {
    studio.sourceFocused = false
    studio.select(studio.scene.entityAt(call.target))
}

@Command
func sceneToggleExpand(studio: Studio!, call: Invocation&): Unit {
    fin entity = studio.scene.entityAt(call.target)
    if storageHas<Expanded>(ensureStorage(studio.scene), entity) {
        storageRemove<Expanded>(ensureStorage(studio.scene), entity)
    } else {
        storageInsert<Expanded>(ensureStorage(studio.scene), entity, .())
    }
    studio.changed()
}

@Command
func sceneToggleVisible(studio: Studio!, call: Invocation&): Unit {
    fin entity = studio.scene.entityAt(call.target)
    fin before = studio.snapshot(entity)
    fin visible = !storageHas<Visibility>(ensureStorage(studio.scene), entity) ||
        storageGet<Visibility>(ensureStorage(studio.scene), entity).visible
    storageInsert<Visibility>(ensureStorage(studio.scene), entity, .(!visible))
    studio.record(entity, before, studio.scene.getParent(entity).id, if visible then "hide" else "show")
}

// ── Components ──────────────────────────────────────────────────────────

@Command
func popupAddComponent(studio: Studio!, call: Invocation&): Unit {
    studio.popup = Popup("addComponent", studio.pointerX, studio.pointerY, -1)
    studio.changed()
}

@Command
func popupClose(studio: Studio!, call: Invocation&): Unit {
    studio.popup = Popup()
    studio.changed()
}

@Command
func componentAdd(studio: Studio!, call: Invocation&): Unit {
    fin selected = studio.selected()
    studio.popup = Popup()
    if !studio.scene.isAlive(selected) then return
    fin before = studio.snapshot(selected)
    var pluginComponent = false
    for contribution in studio.pluginComponents {
        if contribution.id == call.text {
            pluginComponent = setExternalComponent(studio.scene, selected, contribution.id, contribution.defaults)
            break
        }
    }
    if !pluginComponent then addComponent(studio.scene, selected, call.text)
    studio.record(selected, before, studio.scene.getParent(selected).id, "add ${call.text}")
    studio.message("Added ${call.text}")
}

@Command
func componentRemove(studio: Studio!, call: Invocation&): Unit {
    fin selected = studio.selected()
    if !studio.scene.isAlive(selected) then return
    fin before = studio.snapshot(selected)
    if externalComponentText(studio.scene, selected, call.text) != "" then setExternalComponent(studio.scene, selected, call.text, "")
    else removeComponent(studio.scene, selected, call.text)
    studio.record(selected, before, studio.scene.getParent(selected).id, "remove ${call.text}")
    studio.message("Removed ${call.text}")
}

@Command
func componentToggle(studio: Studio!, call: Invocation&): Unit {
    var at: Int = -1
    for i: Int in 0..<studio.collapsed.size then if studio.collapsed[i] == call.text then at = i
    if at >= 0 then studio.collapsed.removeAt(at) else studio.collapsed.add(call.text)
    studio.changed()
}

/** "Component.field" split at the dot. */
func dotted(text: String, second: Bool): String {
    return for i: Int in 0..<stringLength(text) {
        if charAt(text, i) == '.' then
            break if second then substring(text, i + 1, stringLength(text)) else substring(text, 0, i)
    } else if second then "" else text
}

@Command
func fieldToggle(studio: Studio!, call: Invocation&): Unit {
    fin entity = studio.scene.entityAt(call.target)
    fin before = studio.snapshot(entity)
    fin component: String = dotted(call.text, false)
    fin field: String = dotted(call.text, true)
    setFieldFlag(studio.scene, entity, component, field, !fieldFlag(studio.scene, entity, component, field))
    studio.record(entity, before, studio.scene.getParent(entity).id, "edit ${field}")
}

/** The next of an `@Choice` field's options; [call.arg] is how many there are. */
@Command
func fieldCycle(studio: Studio!, call: Invocation&): Unit {
    fin entity = studio.scene.entityAt(call.target)
    fin before = studio.snapshot(entity)
    fin component: String = dotted(call.text, false)
    fin field: String = dotted(call.text, true)
    fin current = fieldNumber(studio.scene, entity, component, field, 0) as Int
    fin next = if call.arg > 0 then (current + 1) % call.arg else 0
    setFieldNumber(studio.scene, entity, component, field, 0, next as Double)
    studio.record(entity, before, studio.scene.getParent(entity).id, "edit ${field}")
}

// ── Assets and problems ─────────────────────────────────────────────────

@Command
func assetsOpen(studio: Studio!, call: Invocation&): Unit {
    studio.assetsPath = call.text
    studio.refreshAssets()
}

@Command
func assetsSelect(studio: Studio!, call: Invocation&): Unit {
    studio.assetSelected = call.text
    if fusionAssetPath(call.text) then openFusionAsset(studio, call.text) else studio.message(call.text)
}

/** Opens the Assets file [call.text] in a tab of its own, or shows its tab when it is open. */
@Command
func assetsEdit(studio: Studio!, call: Invocation&): Unit {
    if !studio.editsAsText(call.text) then return
    if !studio.editDocument(call.text) {
        studio.notify("Could not open ${call.text}", 3)
        return
    }
    studio.showPanel = documentPanel(call.text)
    studio.sourceFocused = true
    studio.focus = FieldFocus()
    studio.revealCursor = true
    studio.message(call.text)
}

@Command(title: "Create Landscape from Heightmap", menu: "Assets", group: 0, order: 1)
func createHeightfield(studio: Studio!, call: Invocation&) {
    fin path = if call.text != "" then call.text else studio.assetSelected
    if !terrainFile(path) {
        studio.notify("Select a PGM heightmap in Assets", 1)
        return
    }
    fin image = readTerrainImage("${studio.root}/${path}")
    if image.samples == 0 {
        studio.notify("Could not read 16-bit PGM heightmap", 3)
        return
    }
    azFree(image.samples)
    fin entity = studio.scene.spawn()
    storageInsert<Name>(ensureStorage(studio.scene), entity, .("Heightfield"))
    storageInsert<Transform>(ensureStorage(studio.scene), entity, .())
    storageInsert<HeightfieldTerrain>(ensureStorage(studio.scene), entity, .(image: path))
    storageInsert<LandscapeCollision>(ensureStorage(studio.scene),entity,.())
    studio.record(entity, "", -1, "create heightfield")
    studio.select(entity)
    studio.showPanel = "ScenePanel"
    studio.message("Created Heightfield")
}

@Command
func problemOpen(studio: Studio!, call: Invocation&): Unit {
    if call.arg < 0 || call.arg >= studio.problems.size then return
    fin problem = studio.problems[call.arg].clone()
    if !studio.editDocument(mainSource) then return
    studio.showPanel = "CodePanel"
    studio.sourceFocused = true
    studio.cursor = studioOffsetAt(studio, problem.line, problem.startByte)
    studio.anchor = -1
    studio.revealCursor = true
    studio.message("${problem.code}: ${problem.message}")
}

/** The offset of zero-based [row]'s byte [column] in the source. */
func studioOffsetAt(studio: Studio!, row: Int, column: Int): Int {
    fin source = studio.editor.source
    var start = 0
    var current = 0
    fin size = azsBufferSize(source)
    while start < size && current < row {
        if azsBufferByte(source, start) == 10 then current = current + 1
        start++
    }
    var end = start
    while end < size && azsBufferByte(source, end) != 10 then end = end + 1
    var offset = start + column
    if offset > end then offset = end
    return offset
}
