@Command(title: "Toggle 2D / 3D", menu: "View", group: 1, order: 0, key: "t", hotkey: "t")
func viewToggle2d(studio: Studio!, call: Invocation&): Unit {
    studio.mode3d = !studio.mode3d
    studio.camera.orthographic = !studio.mode3d
    studio.message(if studio.mode3d then "3D view" else "2D view")
}

@Command(title: "Lit", menu: "View", group: 2, order: 0)
func viewLit(studio: Studio!, call: Invocation&) { studio.viewMode = 0
    studio.changed()
}

@Command(title: "Unlit", menu: "View", group: 2, order: 1)
func viewUnlit(studio: Studio!, call: Invocation&) { studio.viewMode = 1
    studio.changed()
}

@Command(title: "Wireframe", menu: "View", group: 2, order: 2)
func viewWireframe(studio: Studio!, call: Invocation&) { studio.viewMode = 2
    studio.changed()
}

@Command(title: "Focus Selection", menu: "View", group: 1, order: 1, key: "f", shift: true, hotkey: "f")
func viewFocus(studio: Studio!, call: Invocation&): Unit {
    fin selected = studio.selected()
    if !studio.scene.isAlive(selected) {
        studio.camera.focus(.(0.0, 0.5, 0.0), 3.0)
        studio.changed()
        return
    }
    if storageHas<HeightfieldTerrain>(ensureStorage(studio.scene), selected) {
        fin terrain = storageGet<HeightfieldTerrain>(ensureStorage(studio.scene), selected).clone()
        studio.camera.focus(worldPosition(studio.scene, selected), photonMax(terrain.width, terrain.length)*0.25)
        studio.changed()
        return
    }
    var radius: Double = 1.0
    if storageHas<Transform>(ensureStorage(studio.scene), selected) {
        fin scale = storageGet<Transform>(ensureStorage(studio.scene), selected).scale
        radius = clampValue((absValue(scale.x) + absValue(scale.y) + absValue(scale.z)) / 3.0, 0.3, 50.0)
    }
    studio.camera.focus(worldPosition(studio.scene, selected), radius)
    studio.changed()
}

@Command(title: "Toggle Photon Field", menu: "View", group: 3, order: 0)
func viewTogglePhotons(studio: Studio!, call: Invocation&) {
    var light = photonSceneLight(studio.scene)
    if !studio.scene.isAlive(light) then light = photonSceneLight(studio.scene, false)
    if !studio.scene.isAlive(light) {
        studio.notify("Add a Directional Light to enable Photon Field", 1)
        return
    }
    fin before = studio.snapshot(light)
    var field = storageGetOrDefault<PhotonField>(ensureStorage(studio.scene), light, .(enabled: false))
    field.enabled = !field.enabled
    fin enabled = field.enabled
    storageInsert<PhotonField>(ensureStorage(studio.scene), light, take field)
    studio.record(light, before, studio.scene.getParent(light).id, "toggle Photon Field")
    studio.message(if enabled then "Photon Field enabled" else "Photon Field disabled")
}

// ── Run ─────────────────────────────────────────────────────────────────

@Command(title: "Play Scene", menu: "Run", group: 0, order: 0, key: "p")
func runPlay(studio: Studio!, call: Invocation&): Unit {
    if studio.playing && studio.paused {
        studio.paused = false
    } else {
        studio.playing = true
        studio.paused = false
        studio.playTime = 0.0
    }
    studio.message("Scene preview playing")
}

@Command(title: "Pause Scene", menu: "Run", group: 0, order: 1, key: "p", shift: true)
func runPause(studio: Studio!, call: Invocation&): Unit {
    if !studio.playing then return
    studio.paused = !studio.paused
    studio.message(if studio.paused then "Scene preview paused" else "Scene preview playing")
}

@Command(title: "Stop Scene", menu: "Run", group: 0, order: 2)
func runStop(studio: Studio!, call: Invocation&): Unit {
    studio.playing = false
    studio.paused = false
    studio.message("Scene preview stopped")
}

@Command(title: "Build", menu: "Run", group: 1, order: 0, key: "b")
func toolBuild(studio: Studio!, call: Invocation&): Unit {
    studio.requestedTool = "build"
}

@Command(title: "Run App", menu: "Run", group: 1, order: 1, key: "r")
func toolRun(studio: Studio!, call: Invocation&): Unit {
    if saveSceneDocument(studio) then studio.requestedTool = "play"
}

@Command(title: "Check Source", menu: "Run", group: 1, order: 2, key: "i", shift: true)
func toolInspect(studio: Studio!, call: Invocation&): Unit {
    studio.requestedTool = "inspect"
}

@Command(title: "Cancel Build", menu: "Run", group: 1, order: 3)
func toolCancel(studio: Studio!, call: Invocation&): Unit {
    if studio.process != 0 {
        azsProcessCancel(studio.process)
        studio.notify("Cancelled ${studio.processAction}", 3)
    }
}

