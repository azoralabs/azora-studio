// Studio's state. The edited scene is an ECS world of Engine components; what
// the editor adds to it (the selection) is components too, never saved because
// they are not `@Inspectable`. Everything a panel shows is read from here, and
// [Studio.revision] moves whenever any of it changes, so the window recomposes
// only then.

// ── Commands ────────────────────────────────────────────────────────────

/**
 * A Studio command: a function `(studio: Studio!, call: Invocation&)`.
 *
 * Commands are found, not registered. A node runs one through [Pressable] by
 * its declaration name, the menu bar lists those with a [menu], and a key
 * equivalent is [key] with ⌘ (and ⇧ when [shift]).
 */
annot @Command for .Func {
    fin title: String = ""
    fin menu: String = ""
    fin group: Int = 0
    fin order: Int = 0
    fin key: String = ""
    fin shift: Bool = false
    /** A key that runs the command alone, while nothing is being typed. */
    fin hotkey: String = ""
    fin icon: String = ""
}

// ── Editor-only components on scene entities ────────────────────────────

/** The entity the editor has selected. Not saved. */
@Component
pack Selected derives Clone {
    var primary: Bool = true
}

/** A scene-tree row whose children are shown. Not saved. */
@Component
pack Expanded derives Clone {
    var open: Bool = true
}

// ── History ─────────────────────────────────────────────────────────────

/**
 * One undoable change to one entity: everything it carried before and after,
 * as AZON component objects. An empty [before] means the change created it; an
 * empty [after] means the change removed it.
 */
pack SceneEdit derives Clone {
    var entity: Int = -1
    var before: String = ""
    var after: String = ""
    var parentBefore: Int = -1
    var parentAfter: Int = -1
    var label: String = ""
}

/** The value being dragged or typed into an inspector field. */
pack FieldFocus derives Clone {
    var component: String = ""
    var field: String = ""
    var axis: Int = 0
    var typing: Bool = false
    var scrubbing: Bool = false
    var text: String = ""
    var startX: Double = 0.0
    var startValue: Double = 0.0
    var step: Double = 0.1
    var before: String = ""
    /** Whether the field holds a number (typing parses it) or text. */
    var numeric: Bool = true
    var replace: Bool = false
}

pack FoliageBrush {
    var mode: Int = 0
    var radius: Double = 18.0
    var strength: Double = 0.65
    var hover: Bool = false
    var point: Vec3 = .(0.0,0.0,0.0)
    var landscape: Entity = ::invalid
    var before: String = ""
    var last: Vec3 = .(0.0,0.0,0.0)
}

/**
 * The pointer and modifier keys for one frame, from the window or from a
 * scripted session alike: panels read this, never the platform.
 */
pack FrameInput derives Clone {
    var x: Double = 0.0
    var y: Double = 0.0
    var dx: Double = 0.0
    var dy: Double = 0.0
    var pressed: Bool = false
    var down: Bool = false
    var released: Bool = false
    var rightPressed: Bool = false
    var rightDown: Bool = false
    var middleDown: Bool = false
    var middlePressed: Bool = false
    var scrollX: Double = 0.0
    var scrollY: Double = 0.0
    /** Whether the scroll came from two fingers on a trackpad, not a wheel. */
    var preciseScroll: Bool = false
    /** How much a trackpad pinch grew this frame. */
    var pinch: Double = 0.0
    /** Fly keys held this frame, each -1 to 1: W/S forward, D/A right, E/Q up. */
    var flyForward: Double = 0.0
    var flyRight: Double = 0.0
    var flyUp: Double = 0.0
    /** Seconds since the last frame. */
    var seconds: Double = 0.0
    var shift: Bool = false
    var alt: Bool = false
    var command: Bool = false
}

/** A popup shown over everything: a list of commands at a point. */
pack Popup derives Clone {
    var kind: String = ""
    var x: Double = 0.0
    var y: Double = 0.0
    var target: Int = -1
}

// ── Plugins ─────────────────────────────────────────────────────────────

/**
 * An installed plugin: a package folder with a `plugin.azon` manifest, built
 * into a shared library and loaded while Studio runs (see studio.plugins).
 * [state] is 0 found, 1 building, 2 loaded, 3 failed, 4 incompatible.
 */
pack Plugin derives Clone {
    var folder: String = ""
    var id: String = ""
    var name: String = ""
    var version: String = ""
    var description: String = ""
    var abi: Int = 0
    var source: String = "src"
    var main: String = "plugin.az"
    var entry: String = ""
    var tint: Rgba = .(0.62, 0.66, 0.6, 1.0)
    var state: Int = 0
    var library: Long = 0
    /** The loaded library's `entry`, called as `foreign (String) -> Int`. */
    var entryAddress: Long = 0
    var builtIn: Bool = false
    var builds: Int = 0
    var stamp: Double = 0.0
    var message: String = ""
}

/** A tool a loaded plugin adds to the viewport. */
pack PluginTool derives Clone {
    var plugin: String = ""
    var id: String = ""
    var label: String = ""
    var icon: String = "wrench"
    var hint: String = ""
}

/** A plugin's numeric setting, sent with every tool request. */
pack PluginParam derives Clone {
    var plugin: String = ""
    var id: String = ""
    var label: String = ""
    var min: Double = 0.0
    var max: Double = 1.0
    var step: Double = 0.1
    var value: Double = 0.0
    var section: String = "Brush"
}

/** Something a plugin can create, and the objects it has. */
pack PluginKind derives Clone {
    var plugin: String = ""
    var kind: String = ""
    var label: String = ""
    var icon: String = "box"
    var component: String = ""
}

/** A serializable runtime component exposed by an installed plugin. */
pack PluginComponentSpec derives Clone {
    var plugin: String = ""
    var id: String = ""
    var label: String = ""
    var icon: String = "component"
    var defaults: String = "{}"
    var objectKind: String = ""
}

/** A GPU mesh variant and its geometric error in object space. */
pack PluginMeshLevel derives Clone {
    var buffer: Long = 0
    var count: Int = 0
    var maxDeviation: Double = 0.0
}

/** One plugin mesh group and its optional screen-space LOD variants. */
pack PluginMesh derives Clone {
    var plugin: String = ""
    var key: Int = 0
    var object: Int = 0
    var x: Double = 0.0
    var y: Double = 0.0
    var z: Double = 0.0
    var radius: Double = 0.0
    var levels: Array<PluginMeshLevel> = []
}

/** Where a plugin tool's ray last met the plugin's surface. */
pack PluginHit derives Clone {
    var valid: Bool = false
    var x: Double = 0.0
    var y: Double = 0.0
    var z: Double = 0.0
    var nx: Double = 0.0
    var ny: Double = 1.0
    var nz: Double = 0.0
    var radius: Double = 0.0
    var local: Bool = false
    var distance: Double = -1.0
}

/** What one menu item runs: a command, and the text it is invoked with. */
pack MenuEntry derives Clone {
    var menu: String = ""
    var title: String = ""
    var group: Int = 0
    var order: Int = 0
    var key: String = ""
    var shift: Bool = false
    var command: String = ""
    var text: String = ""
}

pack Studio {
    var root: String = ""
    var editor: Editor
    /** Files open in tabs besides the edited one ([editor]'s); see [editDocument]. */
    var documents: Array<OpenFile> = []
    var scene: World = .()
    var history: Array<SceneEdit> = []
    var historyAt: Int = 0
    var sceneDirty: Bool = false
    var revision: Long = 1
    var dock: DockState = .()

    var status: String = "Ready"
    /** 0 ready, 1 working, 2 succeeded, 3 failed. */
    var statusKind: Int = 0
    var console: Long = 0
    var projectLabel: Long = 0
    var problems: Array<Diagnostic> = []
    var problemText: Array<Long> = []
    var problemsStale: Bool = false
    var inspected: Bool = false
    var busy: Bool = false
    var process: Long = 0
    var processAction: String = ""
    /** True from Run until the game it started has been handed activation (see [handOverToGame]). */
    var handingOver: Bool = false
    var requestedTool: String = ""

    var sourceFocused: Bool = false
    var cursor: Int = 0
    /** The selection's fixed end; -1 when nothing is selected. */
    var anchor: Int = -1
    var sourceScroll: Int = 0
    var revealCursor: Bool = true
    var lastEdit: Double = 0.0
    var line: Int = 1
    var column: Int = 1
    var lineCount: Int = 1

    var camera: EditorCamera = .()
    var gizmo: TransformGizmo = .()
    /** 0 none, 1 looking and flying, 2 panning, 3 dragging a handle, 4 selecting source text, 5 orbiting. */
    var viewDrag: Int = 0
    /** Print pointer handling as it happens (AZORA_STUDIO_TRACE). */
    var tracing: Bool = false
    var gizmoStart: Transform = .()
    var gizmoBefore: String = ""
    /** How the Assets panel shows each kind of file (resources/file-types.azon). */
    var fileKinds: Array<FileKind> = []
    /** The Azora mark the top bar shows (resources/azora-logo.png); 0 when missing. */
    var logo: Long = 0
    /** The icon atlas, for canvases that draw icons directly. */
    var icons: IconAtlas = .()
    var meshes: PrimitiveMeshes = .(.(0, 0), .(0, 0), .(0, 0), .(0, 0))
    var mode3d: Bool = true
    var indirectLighting: Bool = true
    var virtualShadows: Bool = true
    /** Temporal upscaling: the 3D view drawn at half resolution per axis and reconstructed. */
    var upscaling: Bool = false
    var pauseViewportDuringPlay: Bool = true
    var recomputeShadows: Bool = false
    var preferencesRoot: String = ""
    /** 0 select, 1 move, 2 rotate, 3 scale. */
    var tool: Int = 1
    var playing: Bool = false
    var paused: Bool = false
    var playTime: Double = 0.0

    var focus: FieldFocus = .()
    var popup: Popup = .()
    var assetsPath: String = ""
    /** The open asset folder's entries: "d name" or "f name", folders first. */
    var assets: Array<String> = []
    var assetSelected: String = ""
    var collapsed: Array<String> = []
    var quitting: Bool = false
    var layoutDirty: Bool = false
    var resetLayout: Bool = false
    /** A panel a command asked to show; the window does it next frame. */
    var showPanel: String = ""
    var pointerX: Double = 0.0
    var pointerY: Double = 0.0
    var presets: Array<EntityPresetSlot> = []
    /** Installed plugins and what the loaded ones add. */
    var plugins: Array<Plugin> = []
    var pluginsRoot: String = ""
    var pluginTools: Array<PluginTool> = []
    var pluginParams: Array<PluginParam> = []
    var pluginKinds: Array<PluginKind> = []
    var pluginComponents: Array<PluginComponentSpec> = []
    var pluginMeshes: Array<PluginMesh> = []
    /** The active plugin tool, "" when the transform tools are in use. */
    var pluginTool: String = ""
    var pluginToolOwner: String = ""
    var pluginHit: PluginHit = .()
    /** The build running now: the plugin's folder, its step and process. */
    var pluginBuilding: String = ""
    var pluginStep: Int = 0
    var pluginProcess: Spawned = .()
    var pluginScanAt: Double = 0.0
    /** Requests queued by commands, run by the frame loop where the GPU is at hand. */
    var pluginRequests: Array<String> = []
    var pluginSave: Bool = false
    var pluginOpen: String = ""
    var pluginInstallPath: String = ""
    var pluginScanned: Bool = false
    var viewMode: Int = 0
    var viewportStarted: Double = 0.0
    var roadTarget: Entity = ::invalid
    var roadPlacement: Int = 0
    var foliageBrush: FoliageBrush = .()
    var atmosphere: AetherRenderer = .()
    var atmosphereState: AetherState = .()
    var atmospherePrevious: Mat4 = mat4Identity()
    var atmosphereOwner: Entity = ::invalid
    var atmosphereTried: Bool = false
    /** Frame rate and frame time, shown in the viewport's top-right corner. */
    var frameStats: FrameStats = .()
    var frameClock: Double = 0.0
    /** Plugin mesh triangles the viewport drew last frame. */
    var pluginTriangles: Int = 0
    var fusion: FusionGraph = .()
    var fusionPath: String = ""
    var fusionDirty: Bool = false
    var fusionCompile: Bool = false
    var fusionReload: String = ""
    var fusionDiagnostic: String = ""
    var fusionSelected: Int = 0
    var fusionPin: Int = 0
    var fusionPanX: Double = 0.0
    var fusionPanY: Double = 0.0
    var fusionZoom: Double = 1.0
    /** What each item of the menu bar runs, by its tag. */
    var menuEntries: Array<MenuEntry> = []
}

/** One entity preset from `resources/presets.azon`: its name, icon and components (AZON). */
/** How the Assets panel shows files with [extension] ('/' a folder, '*' any other). */
pack FileKind derives Clone {
    var extension: String = ""
    var icon: String = "file"
    var color: String = "muted"
    /** Studio opens the file in a text tab. */
    var text: Bool = false
}

/** The file kinds in [text], a `file-types.azon`; none when it is not one. */
func readFileKinds(text: String): Array<FileKind> {
    var kinds: Array<FileKind> = []
    fin root = decodeSerialValue(text, serializerOptions()) catch SerialValue.Null
    when root {
        .Object(members) -> {
            var index = 0
            while index < members.size {
                when members[index].value {
                    .Object(fields) -> {
                        var kind: FileKind = .(members[index].name)
                        var field = 0
                        while field < fields.size {
                            when fields[field].name {
                                "icon" -> { kind.icon = serialAsText(fields[field].value) catch kind.icon }
                                "color" -> { kind.color = serialAsText(fields[field].value) catch kind.color }
                                "text" -> { kind.text = serialAsBool(fields[field].value) catch false }
                                else -> { }
                            }
                            field++
                        }
                        kinds.add(take kind)
                    }
                    else -> { }
                }
                index++
            }
        }
        else -> { }
    }
    return kinds
}

pack EntityPresetSlot derives Clone {
    var name: String = ""
    var icon: String = ""
    var components: String = "{}"
}

impl Studio {
    dtor .() {
        if self.console != 0 then azsBufferClose(self.console)
        if self.projectLabel != 0 then azsBufferClose(self.projectLabel)
        while self.problemText.size > 0 then azsBufferClose(self.problemText.removeLast())
        if self.process != 0 then azsProcessClose(self.process)
        while self.documents.size > 0 {
            var file = self.documents.removeLast()
            azsBufferClose(file.source)
            closeBuffers(file.history)
            closeBuffers(file.future)
        }
    }

    // ── Open files ──────────────────────────────────────────────────────

    /** Whether Studio edits [path] as text, as resources/file-types.azon says. */
    func &.editsAsText(path: String): Bool = self.fileKind(path, false).text

    /** Where [path] is among the parked [documents], or -1. */
    func &.parkedFile(path: String): Int {
        for i: Int in 0..<self.documents.size {
            if self.documents[i].path == path then return i
        }
        return -1
    }

    /** Whether [path] is open with changes not yet saved. */
    func &.documentDirty(path: String): Bool {
        if path == self.editor.path then return self.editor.dirty
        fin at = self.parkedFile(path)
        return at >= 0 && self.documents[at].dirty
    }

    /** Whether any open file has changes not yet saved. */
    func &.documentsDirty(): Bool {
        if self.editor.dirty then return true
        for file in self.documents { if file.dirty then return true }
        return false
    }

    /**
     * Makes project file [path] the edited one, reading it when it is not open
     * yet. The file edited before is parked with its text, undo and caret.
     * False when [path] cannot be read.
     */
    func !.editDocument(path: String): Bool {
        if path == self.editor.path then return true
        fin at = self.parkedFile(path)
        var next = if at >= 0 then self.documents.removeAt(at) else OpenFile(path, azsProjectRead(self.editor.project, path))
        if next.source == 0 then return false
        var parked = OpenFile(self.editor.path, self.editor.source, [], [], self.editor.dirty, self.editor.typingEnd,
            self.cursor, self.anchor, self.sourceScroll)
        moveBuffers(self.editor.history, parked.history)
        moveBuffers(self.editor.future, parked.future)
        self.documents.add(take parked)
        self.editor.path = path
        self.editor.source = next.source
        moveBuffers(next.history, self.editor.history)
        moveBuffers(next.future, self.editor.future)
        self.editor.dirty = next.dirty
        self.editor.typingEnd = next.typingEnd
        fin size = azsBufferSize(next.source)
        self.cursor = if next.cursor > size then size else next.cursor
        self.anchor = if next.anchor > size then -1 else next.anchor
        self.sourceScroll = next.scroll
        self.changed()
        return true
    }

    /** Saves the edited file and every parked one with changes; false when one could not be written. */
    func !.saveDocuments(): Bool {
        var saved = self.editor.save()
        var index = 0
        while index < self.documents.size {
            if self.documents[index].dirty {
                if azsProjectWrite(self.editor.project, self.documents[index].path, self.documents[index].source) == 0 then saved = false
                else self.documents[index].dirty = false
            }
            index++
        }
        return saved
    }

    func !.changed() { self.revision = self.revision + 1 }

    func !.message(value: String) { self.notify(value, 0) }

    /** How the Assets panel shows [name]: by its extension, or as a folder. */
    func &.fileKind(name: String, folder: Bool): FileKind {
        var extension = if folder then "/" else "*"
        if !folder {
            var dot = stringLength(name) - 1
            while dot > 0 && charAt(name, dot) != '.' then dot = dot - 1
            if dot > 0 then extension = substring(name, dot + 1, stringLength(name))
        }
        var fallback: FileKind = .("*")
        for i: Int in 0..<self.fileKinds.size {
            if self.fileKinds[i].extension == extension then return self.fileKinds[i].clone()
            if self.fileKinds[i].extension == "*" then fallback = self.fileKinds[i].clone()
        }
        return fallback
    }

    func !.notify(value: String, kind: Int) {
        self.status = value
        self.statusKind = kind
        self.changed()
    }

    func !.output(value: String) {
        fin next = azsBufferNew(value)
        if next == 0 then return
        if self.console != 0 then azsBufferClose(self.console)
        self.console = next
        self.changed()
    }

    /** Names the project after the last component of [root]. */
    func !.nameProject(root: String) {
        fin path = azsBufferNew(root)
        if path == 0 then return
        var end = azsBufferSize(path)
        while end > 1 && azsBufferByte(path, end - 1) == 47 then end = end - 1
        var start = end
        while start > 0 && azsBufferByte(path, start - 1) != 47 then start = start - 1
        fin label = azsBufferSlice(path, start, end)
        azsBufferClose(path)
        if label == 0 then return
        if self.projectLabel != 0 then azsBufferClose(self.projectLabel)
        self.projectLabel = label
        self.changed()
    }

    func &.projectName(): String = if self.projectLabel == 0 then "project" else azsBufferText(self.projectLabel)

    func &.hasSelection(): Bool = self.anchor >= 0 && self.anchor != self.cursor
    func &.selectionStart(): Int = if self.anchor >= 0 && self.anchor < self.cursor then self.anchor else self.cursor
    func &.selectionEnd(): Int = if self.anchor > self.cursor then self.anchor else self.cursor

    /** Replaces the problems with an inspect snapshot's, for [file]. */
    func !.inspect(snapshot: String, file: String) {
        var text: Array<Long> = []
        var found = parseDiagnostics(snapshot, file, text)
        self.problems = take found
        while self.problemText.size > 0 then azsBufferClose(self.problemText.removeLast())
        self.problemText = take text
        self.problemsStale = false
        self.inspected = true
        self.changed()
    }

    func &.countProblems(severity: Int): Int {
        var count = 0
        for i: Int in 0..<self.problems.size {
            if self.problems[i].severity == severity then count = count + 1
        }
        return count
    }

    /** Records editor facts the chrome shows, recomposing only when one changed. */
    func !.syncSource(line: Int, column: Int, lineCount: Int) {
        if line == self.line && column == self.column && lineCount == self.lineCount then return
        self.line = line
        self.column = column
        self.lineCount = lineCount
        self.changed()
    }

    /** Lists [assetsPath] into [assets]. */
    func !.refreshAssets() {
        while self.assets.size > 0 then self.assets.removeLast()
        fin listing = azsProjectList(self.editor.project, if self.assetsPath == "" then "." else self.assetsPath)
        if listing == 0 {
            self.changed()
            return
        }
        fin size = azsBufferSize(listing)
        var start = 0
        for offset: Int in 0..<size {
            if azsBufferByte(listing, offset) == 10 {
                if offset > start {
                    fin line = azsBufferSlice(listing, start, offset)
                    if line != 0 {
                        self.assets.add(ownedText(line))
                        azsBufferClose(line)
                    }
                }
                start = offset + 1
            }
        }
        azsBufferClose(listing)
        self.changed()
    }

    // ── Selection ───────────────────────────────────────────────────────

    /** The selected entity, or an invalid one. */
    func !.selected(): Entity {
        var index = 0
        while index < storageLength<Selected>(ensureStorage(self.scene)) {
            fin entity = storageEntityAt<Selected>(ensureStorage(self.scene), index)
            if self.scene.isAlive(entity) then return entity
            index++
        }
        return ::invalid
    }

    func !.select(entity: Entity) {
        while storageLength<Selected>(ensureStorage(self.scene)) > 0 {
            storageRemove<Selected>(ensureStorage(self.scene), storageEntityAt(ensureStorage<Selected>(self.scene), 0))
        }
        if self.scene.isAlive(entity) then storageInsert<Selected>(ensureStorage(self.scene), entity, .())
        fin plugin = if self.scene.isAlive(entity) then storageGetOrDefault<PluginObject>(ensureStorage(self.scene), entity, .()).plugin else ""
        if plugin != "" then self.showPanel = "InspectorPanel"
        if self.pluginToolOwner != "" && self.pluginToolOwner != plugin {
            self.pluginToolOwner = ""
            self.pluginTool = ""
            self.pluginHit = .()
        }
        self.focus = FieldFocus()
        self.changed()
    }

    /** [entity]'s display name. */
    func !.nameOf(entity: Entity): String {
        if storageHas<Name>(ensureStorage(self.scene), entity) {
            return storageGet<Name>(ensureStorage(self.scene), entity).value
        }
        return "Entity ${entity.id}"
    }

    // ── History ─────────────────────────────────────────────────────────

    /** Everything [entity] carries, for a [SceneEdit]; empty when it is gone. */
    func !.snapshot(entity: Entity): String = if !self.scene.isAlive(entity) then "" else componentsAzon(self.scene, entity)

    /** Records a change to [entity] that began from [before]. */
    func !.record(entity: Entity, before: String, parentBefore: Int, label: String) {
        fin after = self.snapshot(entity)
        if before == after && parentBefore == self.scene.getParent(entity).id then return
        while self.history.size > self.historyAt then self.history.removeLast()
        self.history.add(SceneEdit(entity.id, before, after, parentBefore, self.scene.getParent(entity).id, label))
        if self.history.size > 512 then self.history.removeAt(0)
        self.historyAt = self.history.size
        self.sceneDirty = true
        self.changed()
    }

    /** Makes [entity] carry exactly what [text] describes; an empty text removes it. */
    func !.restore(id: Int, text: String, parent: Int): Int {
        var entity = self.scene.entityAt(id)
        if stringLength(text) == 0 {
            if self.scene.isAlive(entity) then self.scene.despawn(entity)
            return id
        }
        if !self.scene.isAlive(entity) {
            entity = self.scene.spawn()
            // The entity comes back under a new id; every later edit names it by that.
            for i: Int in 0..<self.history.size {
                if self.history[i].entity == id then self.history[i].entity = entity.id
            }
        }
        clearComponents(self.scene, entity)
        replaceComponents(self.scene, entity, text)
        if parent >= 0 && self.scene.isAlive(self.scene.entityAt(parent)) {
            self.scene.setParent(entity, self.scene.entityAt(parent))
        } else if self.scene.getParent(entity).id >= 0 {
            self.scene.removeParent(entity)
        }
        return entity.id
    }

    func !.undo(): Bool {
        if self.historyAt == 0 then return false
        self.historyAt--
        fin edit = self.history[self.historyAt].clone()
        self.restore(edit.entity, edit.before, edit.parentBefore)
        self.sceneDirty = true
        self.message("Undid ${edit.label}")
        return true
    }

    func !.redo(): Bool {
        if self.historyAt >= self.history.size then return false
        fin edit = self.history[self.historyAt].clone()
        self.historyAt++
        self.restore(edit.entity, edit.after, edit.parentAfter)
        self.sceneDirty = true
        self.message("Redid ${edit.label}")
        return true
    }
}

/** Takes every inspectable component off [entity]. */
func clearComponents(world: World!, entity: Entity) {
    storageRemove<ExternalSceneComponents>(ensureStorage(world), entity)
    inline for C in reflect<*>.withAnnot<Inspectable> {
        storageRemove<C>(ensureStorage(world), entity)
    }
}

/** Puts the components in the AZON object [text] on [entity]. */
func replaceComponents(world: World!, entity: Entity, text: String) {
    fin root = decodeSerialValue(text, serializerOptions()) catch SerialValue.Null
    when root {
        .Object(fields) -> readComponents(world, entity, fields)
        else -> { }
    }
}

// ── Reflected field edits ───────────────────────────────────────────────

/** Whether [entity] carries the component declared as [component]. */
func hasComponent(world: World!, entity: Entity, component: String): Bool {
    inline for C in reflect<*>.withAnnot<Inspectable> {
        if component == reflect<C>.declName then return storageHas<C>(ensureStorage(world), entity)
    }
    return false
}

/** Adds the component declared as [component], with its defaults. */
func addComponent(world: World!, entity: Entity, component: String) {
    inline for C in reflect<*>.withAnnot<Inspectable> {
        if component == reflect<C>.declName && !storageHas<C>(ensureStorage(world), entity) {
            storageInsert<C>(ensureStorage(world), entity, C())
        }
    }
}

func removeComponent(world: World!, entity: Entity, component: String) {
    inline for C in reflect<*>.withAnnot<Inspectable> {
        if component == reflect<C>.declName then storageRemove<C>(ensureStorage(world), entity)
    }
}

/** [value] kept within [min]..[max]. */
func clampTo(value: Double, min: Double, max: Double): Double {
    return when {
        value < min -> min
        value > max -> max
        else -> value
    }
}

/** The number a field shows: [axis] picks a vector's or colour's channel. */
func fieldNumber(world: World!, entity: Entity, component: String, field: String, axis: Int): Double {
    inline for C in reflect<*>.withAnnot<Inspectable> {
        if component == reflect<C>.declName && storageHas<C>(ensureStorage(world), entity) {
            fin value = storageGet<C>(ensureStorage(world), entity).clone()
            inline for f in reflect<C>.fields {
                if field == f.name {
                    inline if f.typeName == "Double" { return value.${f.name} }
                    inline if f.typeName == "Int" { return value.${f.name} as Double }
                    inline if f.typeName == "Vec3" {
                        return when axis {
                            0 -> value.${f.name}.x
                            1 -> value.${f.name}.y
                            else -> value.${f.name}.z
                        }
                    }
                    inline if f.typeName == "Rgba" {
                        return when axis {
                            0 -> value.${f.name}.r
                            1 -> value.${f.name}.g
                            2 -> value.${f.name}.b
                            else -> value.${f.name}.a
                        }
                    }
                }
            }
        }
    }
    return 0.0
}

/** The drag step a field declares with `@Range`. */
func fieldStep(component: String, field: String): Double {
    inline for C in reflect<*>.withAnnot<Inspectable> {
        if component == reflect<C>.declName {
            inline for f in reflect<C>.fields {
                if field == f.name then return reflect<f>.annotMeta<Range>.step
            }
        }
    }
    return 0.1
}

/** Sets a numeric field (or one channel of it), within its declared range. */
func setFieldNumber(world: World!, entity: Entity, component: String, field: String, axis: Int, number: Double) {
    inline for C in reflect<*>.withAnnot<Inspectable> {
        if component == reflect<C>.declName && storageHas<C>(ensureStorage(world), entity) {
            var value = storageGet<C>(ensureStorage(world), entity).clone()
            inline for f in reflect<C>.fields {
                if field == f.name {
                    fin bounded = clampTo(number, reflect<f>.annotMeta<Range>.min, reflect<f>.annotMeta<Range>.max)
                    inline if f.typeName == "Double" { value.${f.name} = bounded }
                    inline if f.typeName == "Int" { value.${f.name} = bounded as Int }
                    inline if f.typeName == "Vec3" {
                        when axis {
                            0 -> { value.${f.name}.x = bounded }
                            1 -> { value.${f.name}.y = bounded }
                            else -> { value.${f.name}.z = bounded }
                        }
                    }
                    inline if f.typeName == "Rgba" {
                        fin unit = clampTo(number, 0.0, 1.0)
                        when axis {
                            0 -> { value.${f.name}.r = unit }
                            1 -> { value.${f.name}.g = unit }
                            2 -> { value.${f.name}.b = unit }
                            else -> { value.${f.name}.a = unit }
                        }
                    }
                }
            }
            storageInsert<C>(ensureStorage(world), entity, take value)
        }
    }
}

/** A `Bool` field's value. */
func fieldFlag(world: World!, entity: Entity, component: String, field: String): Bool {
    inline for C in reflect<*>.withAnnot<Inspectable> {
        if component == reflect<C>.declName && storageHas<C>(ensureStorage(world), entity) {
            fin value = storageGet<C>(ensureStorage(world), entity).clone()
            inline for f in reflect<C>.fields {
                inline if f.typeName == "Bool" {
                    if field == f.name { return value.${f.name} }
                }
            }
        }
    }
    return false
}

func setFieldFlag(world: World!, entity: Entity, component: String, field: String, flag: Bool) {
    inline for C in reflect<*>.withAnnot<Inspectable> {
        if component == reflect<C>.declName && storageHas<C>(ensureStorage(world), entity) {
            var value = storageGet<C>(ensureStorage(world), entity).clone()
            inline for f in reflect<C>.fields {
                inline if f.typeName == "Bool" {
                    if field == f.name { value.${f.name} = flag }
                }
            }
            storageInsert<C>(ensureStorage(world), entity, take value)
        }
    }
}

func setFieldText(world: World!, entity: Entity, component: String, field: String, text: String) {
    inline for C in reflect<*>.withAnnot<Inspectable> {
        if component == reflect<C>.declName && storageHas<C>(ensureStorage(world), entity) {
            var value = storageGet<C>(ensureStorage(world), entity).clone()
            inline for f in reflect<C>.fields {
                inline if f.typeName == "String" {
                    if field == f.name { value.${f.name} = text }
                }
            }
            storageInsert<C>(ensureStorage(world), entity, take value)
        }
    }
}

/** How many choices an `@Choice` field offers. */
func choiceCount(options: String): Int {
    if stringLength(options) == 0 then return 0
    var count = 1
    var index = 0
    while index < stringLength(options) {
        if charAt(options, index) == '|' then count = count + 1
        index++
    }
    return count
}

/** Choice [index] of the `|`-separated [options]. */
func choiceAt(options: String, index: Int): String {
    var current = 0
    var start = 0
    var at = 0
    fin length = stringLength(options)
    while at <= length {
        if at == length || charAt(options, at) == '|' {
            if current == index then return substring(options, start, at)
            current++
            start = at + 1
        }
        at++
    }
    return "${index}"
}

// ── The scene file ──────────────────────────────────────────────────────

/** Where the scene lives in a project. */
inline fin sceneFile = "scene.azscene"

/** An entity with [components] (AZON) under [parent]. */
func spawnFromAzon(world: World!, components: String, parent: Entity): Entity {
    fin entity = world.spawn()
    replaceComponents(world, entity, components)
    if world.isAlive(parent) then world.setParent(entity, parent)
    return entity
}

/**
 * The decimal number [text] spells (`-12.5`, `3`, `.25`), or [fallback] when it
 * spells none. What a person types into a field, nothing more: no exponent,
 * surrounding spaces allowed.
 */
func parseNumber(text: String, fallback: Double): Double {
    var index = 0
    fin length = stringLength(text)
    while index < length && charAt(text, index) == ' ' then index = index + 1
    var negative = false
    if index < length && (charAt(text, index) == '-' || charAt(text, index) == '+') {
        negative = charAt(text, index) == '-'
        index++
    }
    var value: Double = 0.0
    var digits = 0
    while index < length && (charAt(text, index) as Int) >= 48 && (charAt(text, index) as Int) <= 57 {
        value = value * 10.0 + (((charAt(text, index) as Int) - 48) as Double)
        index++
        digits++
    }
    if index < length && (charAt(text, index) == '.' || charAt(text, index) == ',') {
        index++
        var scale: Double = 0.1
        while index < length && (charAt(text, index) as Int) >= 48 && (charAt(text, index) as Int) <= 57 {
            value += scale * (((charAt(text, index) as Int) - 48) as Double)
            scale *= 0.1
            index++
            digits++
        }
    }
    while index < length && charAt(text, index) == ' ' then index = index + 1
    if digits == 0 || index != length then return fallback
    return if negative then -value else value
}

/**
 * [buffer]'s text as a string of its own. The host lends `azsBufferText` only
 * until the buffer changes or closes; anything kept longer is copied here.
 */
func ownedText(buffer: Long): String {
    fin padded = "${azsBufferText(buffer)} "
    return substring(padded, 0, stringLength(padded) - 1)
}
