pack StudioVersion derives Clone {
    var version: String
    var packagePath: String
    var installed: Bool
}

func listStudioVersions(location: String, installed: Bool, versions: Array<StudioVersion>!) {
    if location == "" then return
    fin folder = azsProjectOpen(location, 0)
    if folder == 0 then return
    defer { azsProjectClose(folder) }
    fin listing = azsProjectList(folder, "")
    if listing == 0 then return
    defer { azsBufferClose(listing) }
    for entry in split(azsBufferText(listing), "\n") {
        if !startsWith(entry, "d ") || !endsWith(entry, ".app") then continue
        fin path = "${location}/${substring(entry, 2, stringLength(entry))}"
        fin marker = azsStudioVersion(path)
        if marker == 0 then continue
        fin version = "${azsBufferText(marker)}"
        azsBufferClose(marker)
        var duplicate = false
        for current in versions { if current.version == version then duplicate = true }
        if !duplicate then versions.add(StudioVersion(version, path, installed))
    }
}

func studioVersions(library: String, catalog: String): Array<StudioVersion> {
    var versions: Array<StudioVersion> = []
    listStudioVersions(library, true, versions)
    listStudioVersions(catalog, false, versions)
    return versions
}

inline fin versionsPerPage: Int = 5

impl pack VersionRow {
    react ctor (anchor: Anchor!).(item: StudioVersion&, index: Int): Entity {
        return Row(modifier: ::fillMaxWidth().height(65.0).surface().rounded(9.0).padding(start: 16.0, end: 12.0), spacing: 14.0, verticalAlignment: .Center, key: item.version) {
            Shape(modifier: ::size(4.0, 32.0).rounded(2.0).background(0.820, 0.306, 0.918))
            Column(modifier: ::weight(1.0).height(40.0), spacing: 3.0) {
                Text("Azora Studio ${item.version}", modifier: ::fillMaxWidth().height(21.0).fontSize(16.0).semibold().textAlign(.Start))
                Text(if item.installed then "Installed" else "Available to install", modifier: ::fillMaxWidth().height(16.0).fontSize(12.0).mutedText().textAlign(.Start))
            }
            StartupButton(if item.installed then "Launch" else "Install", 100 + index, 105.0, true)
        }
    }
}

impl pack StudioLibrary {
    react ctor (anchor: Anchor!).(versions: Array<StudioVersion>&, page: Int, status: String): Entity {
        return Column(modifier: ::fillMaxSize().ground().padding(all: 28.0), spacing: 10.0, key: "library") {
            Row(modifier: ::fillMaxWidth().height(52.0), spacing: 10.0, verticalAlignment: .Center) {
                Column(modifier: ::weight(1.0).fillMaxHeight(), spacing: 3.0) {
                    Text("AZORA LAUNCHER", modifier: ::fillMaxWidth().height(15.0).caption())
                    Text("Studio Library", modifier: ::fillMaxWidth().height(31.0).fontSize(26.0).semibold().textAlign(.Start))
                }
                StartupButton("Refresh", 2, 82.0)
                StartupButton("Install from file…", 1, 149.0)
            }
            if versions.size == 0 {
                Text("Choose a Studio package to add your first version.", modifier: ::fillMaxWidth().height(72.0).surface().rounded(9.0).padding(start: 16.0).mutedText().textAlign(.Start))
            }
            for i: Int in 0..<versionsPerPage {
                fin index = page * versionsPerPage + i
                if index < versions.size then VersionRow(versions[index].&, index)
            }
            if versions.size > versionsPerPage {
                Row(modifier: ::fillMaxWidth().height(36.0), spacing: 8.0, verticalAlignment: .Center) {
                    if page > 0 then StartupButton("Previous", 3, 88.0)
                    Text("${page + 1} / ${(versions.size + versionsPerPage - 1) / versionsPerPage}", modifier: ::width(45.0).mutedText())
                    if (page + 1) * versionsPerPage < versions.size then StartupButton("Next", 4, 88.0)
                }
            }
            Shape(modifier: ::weight(1.0).background(0.0, 0.0, 0.0, 0.0))
            Text(status, modifier: ::fillMaxWidth().height(22.0).fontSize(12.0).mutedText().textAlign(.Start), key: "status")
        }
    }
}

react func main() {
    if azsAbiVersion() != 1 then azsExit(1)
    fin home = azsEnvironment("HOME")
    fin libraryOverride = azsEnvironment("AZORA_STUDIO_LIBRARY")
    fin catalog = azsEnvironment("AZORA_STUDIO_CATALOG")
    fin library = if libraryOverride != "" then libraryOverride else "${home}/Library/Application Support/Azora Studio/Versions"
    var versions = studioVersions(library, catalog)
    var world: World = .()
    var pass = Composition::of(world, "launcher")
    var app = appInit("Azora Launcher", 860, 580)
    if !app.ok then azsExit(1)
    azsSetEnvironment("AZORA_STUDIO_PROJECT", "")
    azsSetEnvironment("AZORA_STUDIO_SCENE", "")
    var player = ScriptPlayer::open(azsEnvironment("AZORA_LAUNCHER_SCRIPT"))
    var status = ""
    var sessions: Array<Long> = []
    var page = 0
    var frames = 0
    var revision: Long = 1
    var layoutVersion: Long = -1
    var lastWidth: Double = -1.0
    var lastHeight: Double = -1.0
    var paintList: PaintList = .()
    fin frameLimit = azsEnvironmentInt("AZORA_LAUNCHER_FRAME_LIMIT")
    while app.frame() {
        frames++
        fin cue = player.next(app, frames)
        var action = 0
        if cue.click then action = pass.hit(player.x, player.y)
        else if !player.pointing && app.mouseClicked(.Left) then action = pass.hit(app.mouseX(), app.mouseY())
        if app.keyDown(.Meta) && app.keyJustPressed(.O) then action = 1
        if action == 3 || action == 4 {
            page += if action == 3 then -1 else 1
            revision++
        }
        var packagePath = if cue.command == "install" then cue.argument else ""
        if action == 1 then packagePath = chooseStartupPath("Install Studio", if catalog == "" then "${home}/Downloads" else catalog, true)
        if cue.command == "launch" {
            for i: Int in 0..<versions.size {
                if versions[i].version == cue.argument && versions[i].installed then action = 100 + i
            }
        }
        if action >= 100 && action - 100 < versions.size {
            fin item = versions[action - 100].clone()
            if item.installed {
                fin process = azsStudioStart("${item.packagePath}/Contents/MacOS/azora-studio")
                if process == 0 then status = "${azsError()}"
                else {
                    sessions.add(process)
                    status = "Opened Azora Studio ${item.version}."
                }
                revision++
            } else { packagePath = item.packagePath }
        }
        if packagePath != "" {
            if !ensureStartupDirectory(library) then status = "Could not create the Studio library."
            else if azsStudioInstall(packagePath, library) == 0 then status = "${azsError()}"
            else { status = "Studio installed." }
            action = 2
        }
        if action == 2 {
            versions = studioVersions(library, catalog)
            page = 0
            revision++
        }
        var at = sessions.size
        while at > 0 {
            at--
            fin result = azsProcessPoll(sessions[at])
            if result == -1 then continue
            azsProcessClose(sessions[at])
            sessions.removeAt(at)
            if result != 0 {
                status = "Studio exited (${result}). See the Launcher log."
                revision++
            }
        }
        composeIfChanged(pass, revision) { StudioLibrary(versions, page, status) }
        fin root = pass.findChild(pass.root, "library")
        fin width = app.width() as Double
        fin height = app.height() as Double
        if pass.version != layoutVersion || width != lastWidth || height != lastHeight {
            pass.arrange(root, 0.0, 0.0, width, height)
            layoutVersion = pass.version
            lastWidth = width
            lastHeight = height
            paintList.clear()
            recordTree(app, pass, root, 0.0, height, paintList)
        }
        player.capture(app, "", cue.shot)
        replayPaint(app, paintList)
        app.present()
        if frameLimit > 0 && frames >= frameLimit then app.quit()
    }
    for session in sessions then azsProcessClose(session)
    player.close()
    pass.dispose()
    app.shutdown()
    if azsLiveHandles() != 0 then azsExit(1)
}
