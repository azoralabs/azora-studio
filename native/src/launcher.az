/** Metadata is optional for older templates that only ship src/main.az. */
pack LauncherTemplate derives Clone {
    var folder: String
    var title: String
    var detail: String = ""
    var color: String = ""
    var order: Int = 1000
}

func templatesIn(home: String): Array<LauncherTemplate> {
    var catalogue: Array<LauncherTemplate> = []
    fin root = "${home}/templates"
    fin project = azsProjectOpen(root, 0)
    if project == 0 then return catalogue
    defer { azsProjectClose(project) }
    fin listing = azsProjectList(project, "")
    if listing == 0 then return catalogue
    defer { azsBufferClose(listing) }
    for entry in split(azsBufferText(listing), "\n") {
        if !startsWith(entry, "d ") then continue
        fin folder = substring(entry, 2, stringLength(entry))
        fin source = azsProjectRead(project, "${folder}/src/main.az")
        if source == 0 then continue
        azsBufferClose(source)
        var item: LauncherTemplate = .(folder, folder)
        fin manifest = azsProjectRead(project, "${folder}/template.azon")
        if manifest != 0 {
            fin metadata = decodeSerialValue(azsBufferText(manifest), serializerOptions()) catch SerialValue.Null
            when metadata {
                .Object(fields) -> {
                    for field in fields {
                        when field.name {
                            "title" -> { item.title = serialAsText(field.value) catch folder }
                            "description" -> { item.detail = serialAsText(field.value) catch "" }
                            "color" -> { item.color = serialAsText(field.value) catch "" }
                            "order" -> { item.order = serialAsInt(field.value) catch 1000 }
                            else -> { }
                        }
                    }
                }
                else -> { }
            }
            azsBufferClose(manifest)
        }
        catalogue.add(item.clone())
        var at = catalogue.size - 1
        while at > 0 && catalogue[at - 1].order > item.order {
            catalogue[at] = catalogue[at - 1].clone()
            at--
        }
        catalogue[at] = item.clone()
    }
    return catalogue
}

inline fin templatesPerRow: Int = 4
inline fin templatesPerPage: Int = 8

impl pack TemplateCard {
    react ctor (anchor: Anchor!).(item: LauncherTemplate&, index: Int, selected: Bool): Entity {
        fin base = Modifier::weight(1.0).fillMaxHeight().rounded(10.0).surface().hoverable()
        fin look = if selected then base.border(2.0, 0.820, 0.306, 0.918) else base.border(1.0, 0.173, 0.173, 0.192)
        fin tint = themeColor(item.color, studioTheme.brand)
        return Button(modifier: look, action: 40 + index, key: item.folder) {
            Column(modifier: ::fillMaxSize().padding(all: 12.0), spacing: 8.0, key: "content") {
                Shape(modifier: ::fillMaxWidth().height(58.0).rounded(7.0).background(tint.r, tint.g, tint.b, 0.85))
                Text(item.title, modifier: ::fillMaxWidth().height(24.0).fontSize(14.0).semibold().textAlign(.Start))
            }
        }
    }
}

impl pack LauncherButton {
    react ctor (anchor: Anchor!).(label: String, action: Int, width: Double, primary: Bool): Entity {
        fin base = Modifier::width(width).height(36.0).rounded(8.0)
        return Button(modifier: if primary then base.background(0.561, 0.180, 0.706).hover(0.663, 0.235, 0.820) else base.raised().hoverable(), :action, key: label) {
            Text(label, modifier: ::fontSize(13.0))
        }
    }
}

impl pack ProjectWelcome {
    react ctor (anchor: Anchor!).(root: String, status: String, catalogue: Array<LauncherTemplate>&, selected: Int, page: Int, studioOpen: Bool): Entity {
        return Row(modifier: ::fillMaxSize().ground(), key: "welcome") {
            Column(modifier: ::width(220.0).fillMaxHeight().surface().padding(all: 14.0), spacing: 4.0, key: "sidebar") {
                Row(modifier: ::fillMaxWidth().height(40.0), spacing: 10.0, verticalAlignment: .Center, key: "brand") {
                    Shape(modifier: ::size(24.0, 24.0).rounded(7.0).background(0.820, 0.306, 0.918))
                    Text("Azora", modifier: ::weight(1.0).fontSize(18.0).semibold().textAlign(.Start))
                }
                Text("Engine 0.1 · native toolchain", modifier: ::fillMaxWidth().height(20.0).fontSize(11.0).faintText().textAlign(.Start), key: "version")
                Shape(modifier: ::fillMaxWidth().height(14.0).background(0.0, 0.0, 0.0, 0.0))
                Shape(modifier: ::weight(1.0).background(0.0, 0.0, 0.0, 0.0))
                Text(if studioOpen then "Studio is running" else "Studio is closed", modifier: ::fillMaxWidth().height(20.0).fontSize(11.0).faintText().textAlign(.Start), key: "session")
            }
            Column(modifier: ::weight(1.0).fillMaxHeight().padding(all: 28.0), spacing: 14.0, key: "main") {
                Text("Create a project", modifier: ::fillMaxWidth().height(34.0).fontSize(24.0).semibold().textAlign(.Start), key: "title")
                Text("Start from an Azora Engine template. Studio opens it as soon as it is created.", modifier: ::fillMaxWidth().height(20.0).fontSize(13.0).mutedText().textAlign(.Start), key: "subtitle")
                for row: Int in 0..<2 {
                    Row(modifier: ::fillMaxWidth().height(120.0), spacing: 12.0, key: "row-${row}") {
                        fin first = page * templatesPerPage + row * templatesPerRow
                        for column: Int in 0..<templatesPerRow {
                            fin index = first + column
                            if index < catalogue.size then TemplateCard(catalogue[index].&, index, selected == index)
                            else Shape(modifier: ::weight(1.0).fillMaxHeight(), key: "space-${column}")
                        }
                    }
                }
                if catalogue.size > templatesPerPage {
                    Row(modifier: ::fillMaxWidth().height(36.0), spacing: 8.0, verticalAlignment: .Center) {
                        if page > 0 then LauncherButton("Previous", 3, 100.0, false)
                        Text("${page + 1} / ${(catalogue.size + templatesPerPage - 1) / templatesPerPage}", modifier: ::width(48.0).mutedText())
                        if (page + 1) * templatesPerPage < catalogue.size then LauncherButton("Next", 4, 100.0, false)
                    }
                }
                if catalogue.size > 0 {
                    Text(catalogue[selected].detail, modifier: ::fillMaxWidth().height(18.0).fontSize(12.0).mutedText().textAlign(.Start), key: "description")
                }
                Text("LOCATION", modifier: ::fillMaxWidth().height(22.0).caption(), key: "location-caption")
                Text(root, modifier: ::fillMaxWidth().height(36.0).sunken().rounded(8.0).border(1.0, 0.173, 0.173, 0.192).padding(start: 12.0).monospace().fontSize(12.0).textAlign(.Start), key: "location")
                Shape(modifier: ::weight(1.0).background(0.0, 0.0, 0.0, 0.0))
                Row(modifier: ::fillMaxWidth().height(40.0), spacing: 10.0, verticalAlignment: .Center, key: "actions") {
                    Text(status, modifier: ::weight(1.0).fontSize(12.0).mutedText().textAlign(.Start), key: "status")
                    LauncherButton("Open project…  O", 2, 150.0, false)
                    if catalogue.size > 0 then LauncherButton("Create project  ↵", 1, 150.0, true)
                }
            }
        }
    }
}

func projectNameDialog(initial: String): String {
    fin alert = newObject("NSAlert")
    defer { send0(alert, sel("release")) }
    fin field = azSendQuad(send0(cls("NSTextField"), sel("alloc")), sel("initWithFrame:"), 0.0, 0.0, 320.0, 24.0)
    defer { send0(field, sel("release")) }
    send1(alert, sel("setMessageText:"), nsString("Name your Azora project"))
    send1(alert, sel("addButtonWithTitle:"), nsString("Create"))
    send1(alert, sel("addButtonWithTitle:"), nsString("Cancel"))
    send1(field, sel("setStringValue:"), nsString(initial))
    send1(alert, sel("setAccessoryView:"), field)
    send1(send0(alert, sel("window")), sel("setInitialFirstResponder:"), field)
    if send0(alert, sel("runModal")) != 1000 then return ""
    return trim(nsStringText(send0(field, sel("stringValue"))))
}

func selectProjectFolder(location: String): String {
    fin panel = send0(cls("NSOpenPanel"), sel("openPanel"))
    send1(panel, sel("setCanChooseDirectories:"), 1)
    send1(panel, sel("setCanChooseFiles:"), 0)
    send1(panel, sel("setPrompt:"), nsString("Open Project"))
    send1(panel, sel("setDirectoryURL:"), send1(cls("NSURL"), sel("fileURLWithPath:"), nsString(location)))
    if send0(panel, sel("runModal")) != 1 then return ""
    return nsStringText(send0(send0(panel, sel("URL")), sel("path")))
}

func ensureProjectFolder(location: String): Bool {
    fin files = send0(cls("NSFileManager"), sel("defaultManager"))
    return send5(files, sel("createDirectoryAtPath:withIntermediateDirectories:attributes:error:"), nsString(location), 1, 0, 0, 0) != 0
}

func launchProject(root: String): Long {
    fin project = azsProjectOpen(root, 0)
    if project == 0 then return 0
    defer { azsProjectClose(project) }
    fin source = azsProjectRead(project, "src/main.az")
    if source == 0 then return 0
    azsBufferClose(source)
    if azsSetEnvironment("AZORA_STUDIO_PROJECT", root) == 0 then return 0
    return azsStudioStart(azsEnvironment("AZORA_STUDIO_EXECUTABLE"))
}

pack StudioSession derives Clone {
    var root: String
    var process: Long
}

func activateStudio(process: Long) {
    fin app = send1(cls("NSRunningApplication"), sel("runningApplicationWithProcessIdentifier:"), azsProcessPid(process) as Long)
    send1(app, sel("activateWithOptions:"), 2)
}

react func main() {
    if azsAbiVersion() != 1 { println("incompatible Launcher host ABI")
        return }
    fin requested = "${azsEnvironment("AZORA_LAUNCHER_PROJECT")}"
    fin location = "${azsEnvironment("HOME")}/Documents/Azora"
    fin engine = azsEnvironment("AZORA_ENGINE_HOME")
    fin catalogue = templatesIn(engine)
    var root = if requested != "" then requested else location
    var world: World = .()
    var pass = Composition::of(world, "launcher")
    var app = appInit("Azora", 1040, 640)
    if !app.ok then return
    app.setClearColor(0.078, 0.078, 0.086)
    var status = if catalogue.size == 0 then "No Engine templates found." else "Pick a template, then create the project."
    var selected = 0
    var page = 0
    var revision: Long = 1
    var studios: Array<StudioSession> = []
    var frames = 0
    var layoutVersion: Long = -1
    var lastWidth: Double = -1.0
    var lastHeight: Double = -1.0
    var paintList: PaintList = .()
    var paintVersion: Long = -1
    fin frameLimit = azsEnvironmentInt("AZORA_STUDIO_FRAME_LIMIT")
    while app.frame() {
        frames++
        var action = 0
        if app.mouseClicked(.Left) then action = pass.hit(app.mouseX(), app.mouseY())
        if app.keyJustPressed(.Enter) || (app.keyDown(.Meta) && app.keyJustPressed(.N)) then action = 1
        if app.keyJustPressed(.O) then action = 2
        if action >= 40 && action - 40 < catalogue.size {
            selected = action - 40
            status = catalogue[selected].title
            revision++
        }
        if action == 3 || action == 4 {
            page += if action == 3 then -1 else 1
            selected = page * templatesPerPage
            status = catalogue[selected].title
            revision++
        }
        var toOpen = ""
        if action == 2 then toOpen = selectProjectFolder(location)
        if action == 1 && catalogue.size > 0 {
            fin name = if requested != "" then "" else projectNameDialog("")
            if name == "." || name == ".." || indexOf(name, "/") >= 0 || indexOf(name, "\\") >= 0 {
                status = "Enter a project name without path separators."
            } else if requested != "" || name != "" {
                fin target = if requested != "" then requested else "${location}/${name}"
                if requested == "" && !ensureProjectFolder(location) {
                    status = "Could not create ${location}. Check Documents access."
                } else if createNativeProject(target, "${engine}/templates/${catalogue[selected].folder}") {
                    root = target
                    toOpen = target
                } else { status = "${azsError()}" }
            }
            revision++
        }
        var session = studios.size
        while session > 0 {
            session--
            fin studio = studios[session].process
            fin result = azsProcessPoll(studio)
            if result != -1 {
                azsProcessClose(studio)
                studios.removeAt(session)
                status = if result == 0 then "Studio closed." else "Studio exited (${result}). See the Launcher log."
                revision++
            }
        }
        if toOpen != "" {
            var existing: Long = 0
            for current in studios { if current.root == toOpen then existing = current.process }
            if existing != 0 {
                activateStudio(existing)
                root = toOpen
                status = "Project is open in Studio."
            } else {
                fin studio = launchProject(toOpen)
                if studio == 0 { status = "${azsError()}" }
                else {
                    studios.add(StudioSession(toOpen, studio))
                    root = toOpen
                    status = "Opening project in Studio…"
                }
            }
            revision++
        }
        composeIfChanged(pass, revision) { ProjectWelcome(root, status, catalogue, selected, page, studios.size > 0) }
        fin welcome = pass.findChild(pass.root, "welcome")
        fin width = app.width() as Double
        fin height = app.height() as Double
        if pass.version != layoutVersion || width != lastWidth || height != lastHeight {
            pass.arrange(welcome, 0.0, 0.0, width, height)
            layoutVersion = pass.version
            lastWidth = width
            lastHeight = height
            // A new size moves everything without changing the tree, so the
            // recorded paint is stale even though the version is not.
            paintVersion = -1
        }
        if paintVersion != layoutVersion {
            paintList.clear()
            recordTree(app, pass, welcome, 0.0, height, paintList)
            paintVersion = layoutVersion
        }
        replayPaint(app, paintList)
        app.present()
        if frameLimit > 0 && frames >= frameLimit then app.quit()
    }
    for studio in studios then azsProcessClose(studio.process)
    pass.dispose()
    app.shutdown()
    if azsLiveHandles() != 0 { println("native handle leak")
        azsExit(1) }
}
