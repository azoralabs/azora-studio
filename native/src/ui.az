module studio.ui
import std.traits
import engine.core
import engine.ecs
import engine.platform
import engine.gpu.draw
import engine.ui.node
import engine.ui.compose
import studio.theme

// Studio's small parts. Each is an Engine constructor; what one does when it
// is pressed is a command named on it ([Pressable]), so a part never knows
// what the command does and a command never knows where it is drawn.

/** What a command is invoked with. */
pack Invocation derives Clone {
    var target: Int = -1
    var arg: Int = 0
    var number: Double = 0.0
    var text: String = ""
}

/** A node that runs [command] when it is pressed, and [double] when pressed twice in quick succession. */
@Component
pack Pressable derives Clone {
    var command: String = ""
    var target: Int = -1
    var arg: Int = 0
    var text: String = ""
    var double: String = ""
}

/** Fills the leftover room along its row or column. */
impl pack Spacer {
    react ctor (_: Anchor!).(key: String = ""): Entity {
        return Shape(modifier: ::weight(1.0).fill(studioTheme.ground.withAlpha(0.0)), :key)
    }
}

/** A fixed gap. */
impl pack Gap {
    react ctor (anchor: Anchor!).(size: Double, key: String = ""): Entity {
        return Shape(modifier: ::size(size, size).fill(studioTheme.ground.withAlpha(0.0)), :key)
    }
}

/** A short vertical hairline between groups in a bar. */
impl pack Divider {
    react ctor (anchor: Anchor!).(height: Double = 18.0, key: String = ""): Entity {
        return Shape(modifier: ::width(1.0).height(height).hairline(), :key)
    }
}

/** Text sized to fit itself, so a row can place what follows it. */
impl pack Label {
    react ctor (anchor: Anchor!).(
        text: String
        app: App&
        color: Rgba
        size: Double = 12.5
        bold: Bool = false
        mono: Bool = false
        key: String = ""
    ): Entity {
        fin font = when {
            bold -> uiFontSemibold
            mono -> uiFontMonospace
            else -> uiFontRegular
        }
        fin width = app.uiTextWidthFont(text, size, font) + 2.0
        fin look = Modifier::width(width).fontSize(size).ink(color).textAlign(.Start)
        fin styled = when {
            bold -> look.semibold()
            mono -> look.monospace()
            else -> look
        }
        return Text(text, modifier: styled, :key)
    }
}

/** A row that runs [command] when pressed. */
impl pack Press {
    react ctor (anchor: Anchor!).(
        command: String
        modifier: Modifier& = .()
        target: Int = -1
        arg: Int = 0
        text: String = ""
        double: String = ""
        spacing: Double = 0.0
        center: Bool = false
        key: String = ""
        children: inline react Anchor!.() -> Unit
    ): Entity {
        fin id: String = if key == "" then anchor.pass.positionalKey(anchor.parent, "press") else key
        fin node = anchor.pass.row(anchor.parent, id, modifier, if center then .Center else .Start, .Center, spacing)
        storageInsert<Pressable>(store(anchor.pass), node, .(command, target, arg, text, double))
        using anchor.inside(node) then children()
        return node
    }
}

/** A bar button: a glyph and an optional caption, raised when [active]. */
impl pack BarButton {
    react ctor (anchor: Anchor!).(
        command: String
        app: App&
        icon: String = ""
        label: String = ""
        active: Bool = false
        tint: Rgba = Rgba(0.851, 0.855, 0.855, 1.0)
        arg: Int = 0
        key: String = ""
    ): Entity {
        fin labelWidth: Double = if label == "" then 0.0 else app.uiTextWidth(label, 12.5) + 6.0
        fin width = (if icon == "" then 12.0 else studioTheme.iconSize + 10.0) +
            labelWidth + (if label == "" then 0.0 else 8.0)
        fin base = Modifier::width(width)
            .height(26.0)
            .rounded(6.0)
            .padding(start: if icon == "" then 10.0 else 5.0, end: 4.0)
        return Press(
            command
            modifier: if active then base.raised().hoverFill(studioTheme.hover.withAlpha(0.12)) else base.ghost()
            spacing: 5.0
            :arg
            :key
        ) {
            if icon != "" then Icon(icon, tint, size: studioTheme.iconSize, key: "icon")
            if label != "" then Label(label, app, if active then studioTheme.text else studioTheme.muted, key: "label")
        }
    }
}
