// The Studio window. Panels are found by reflection, commands are found by
// reflection, and the layout is ECS state the dock rearranges; this file only
// wires a frame together: input in, commands run, the tree recomposed when a
// revision moved, then painted - main window, floating windows, popup - each
// with its panels' own surfaces drawn over it.

// ── Panels and canvases ─────────────────────────────────────────────────

/** Passes the pointer to the `@Canvas` panel [panel]; answers whether it used it. */
/** 1 while [positive] is held, -1 while [negative] is, 0 for both or neither. */
func keyAxis(app: App&, positive: Int, negative: Int): Double {
    var axis: Double = 0.0
    if app.keyDown(positive) { axis = axis + 1.0 }
    if app.keyDown(negative) { axis = axis - 1.0 }
    return axis
}

func canvasPointer(panel: String, app: App&, studio: Studio!, rect: ViewRect&, input: FrameInput&): Bool {
    inline for P in reflect<*>.withAnnot<Panel> {
        inline if reflect<P>.hasAnnot<Canvas> {
            if panel == reflect<P>.declName { return P::pointer(app, studio, rect, input) }
        }
    }
    return false
}

/** Has the `@Canvas` panel [panel] draw into [rect]. */
func canvasDraw(panel: String, app: App!, studio: Studio!, rect: ViewRect&) {
    inline for P in reflect<*>.withAnnot<Panel> {
        inline if reflect<P>.hasAnnot<Canvas> {
            if panel == reflect<P>.declName { P::draw(app, studio, rect) }
        }
    }
}

/** Whether [node] hangs, at any depth, under [root] in [pass]. */
func isUnder(pass: Composition!, node: Entity, root: Entity): Bool {
    var current = node
    var depth = 0
    while current.isValid && depth < 64 {
        if current.id == root.id && current.generation == root.generation { return true }
        current = storageGetOrDefault<Child>(store<Child>(pass), current, Child(Entity::invalid)).parent
        depth = depth + 1
    }
    return false
}

/** Draws every panel surface under [root]. */
func drawCanvases(app: App!, studio: Studio!, pass: Composition!, root: Entity) {
    var index = 0
    while index < storageLength<PanelSurface>(store<PanelSurface>(pass)) {
        fin node = storageEntityAt<PanelSurface>(store<PanelSurface>(pass), index)
        if node.isValid && isUnder(pass, node, root) {
            fin surface = storageGetOrDefault<PanelSurface>(store<PanelSurface>(pass), node, PanelSurface())
            fin area = storageGetOrDefault<Rect>(store<Rect>(pass), node, Rect())
            if area.width > 2.0 && area.height > 2.0 {
                canvasDraw(surface.panel, app, studio, ViewRect(area.x, area.y, area.width, area.height))
            }
        }
        index = index + 1
    }
}

// ── Chrome ──────────────────────────────────────────────────────────────

pack TopBar { }
impl TopBar {
    react ctor (anchor: Anchor!).(studio: Studio&, app: App&): Entity {
        fin running = studio.playing && !studio.paused
        return Row(modifier: Modifier::fillMaxWidth().height(42.0).padding(start: 14.0, end: 12.0), spacing: 6.0, verticalAlignment: .Center, key: "topbar") {
            if studio.logo != Long(0) {
                ImageView(studio.logo, modifier: Modifier::size(20.0, 20.0), key: "mark")
            } else {
                Shape(modifier: Modifier::size(18.0, 18.0).rounded(5.0).fill(studioTheme.brand), key: "mark")
            }
            Label("Azora Studio", app, studioTheme.text, size: 13.5, bold: true, key: "name")
            Icon("chevron-right", studioTheme.faint, size: studioTheme.iconSmall, key: "sep")
            Label(studio.projectName(), app, studioTheme.muted, size: 13.0, key: "project")
            if studio.sceneDirty || studio.editor.dirty {
                Shape(modifier: Modifier::size(7.0, 7.0).rounded(3.5).fill(studioTheme.orange), key: "dirty")
            }
            Spacer(key: "left")
            Row(modifier: Modifier::height(30.0).raised().rounded(8.0).padding(start: 3.0, end: 3.0), spacing: 2.0, verticalAlignment: .Center, key: "transport") {
                BarButton("runPlay", app, icon: "play", active: running, tint: studioTheme.green, key: "play")
                BarButton("runPause", app, icon: "pause", active: studio.paused, tint: studioTheme.yellow, key: "pause")
                BarButton("runStop", app, icon: "square", tint: if studio.playing { studioTheme.red } else { studioTheme.muted }, key: "stop")
            }
            Spacer(key: "right")
            BarButton("toolBuild", app, icon: "hammer", label: "Build", key: "build")
            Press(if studio.busy { "toolCancel" } else { "toolRun" }, modifier: Modifier::height(28.0).rounded(7.0).accent().padding(start: 12.0, end: 12.0), spacing: 6.0, key: "run") {
                Icon(if studio.busy { "square" } else { "play" }, studioTheme.ground, size: studioTheme.iconSmall, key: "glyph")
                Label(if studio.busy { "Cancel" } else { "Run app" }, app, studioTheme.ground, bold: true, key: "label")
            }
        }
    }
}

pack StatusBar { }
impl StatusBar {
    react ctor (anchor: Anchor!).(studio: Studio&, app: App&): Entity {
        fin tint = when studio.statusKind {
            3 -> studioTheme.error
            1 -> studioTheme.warning
            2 -> studioTheme.green
            else -> studioTheme.faint
        }
        fin errors = studio.countProblems(0)
        fin warnings = studio.countProblems(1)
        return Row(modifier: Modifier::fillMaxWidth().height(26.0).padding(start: 14.0, end: 14.0), spacing: 8.0, verticalAlignment: .Center, key: "statusbar") {
            Shape(modifier: Modifier::size(7.0, 7.0).rounded(3.5).fill(tint), key: "dot")
            Label(studio.status, app, studioTheme.muted, size: 11.5, key: "message")
            Spacer(key: "fill")
            Press("panelShow", modifier: Modifier::height(20.0).rounded(4.0).ghost().padding(start: 6.0, end: 6.0), text: "ProblemsPanel", spacing: 5.0, key: "problems") {
                Icon("circle-x", if errors > 0 { studioTheme.error } else { studioTheme.faint }, size: studioTheme.iconSmall, key: "errors-glyph")
                Label("${errors}", app, studioTheme.muted, size: 11.5, key: "errors")
                Icon("triangle-alert", if warnings > 0 { studioTheme.warning } else { studioTheme.faint }, size: studioTheme.iconSmall, key: "warnings-glyph")
                Label("${warnings}", app, studioTheme.muted, size: 11.5, key: "warnings")
            }
            Divider(height: 12.0, key: "divider")
            Label("Azora 0.1 · LLVM native", app, studioTheme.faint, size: 11.5, key: "toolchain")
        }
    }
}

/** A popup's rows: components to add, or entity presets. */
react func (anchor: Anchor!).popupRows(studio: Studio&, app: App&) {
    when studio.popup.kind {
        "addComponent" -> {
            fin entity = selectedEntity(studio)
            Text("ADD COMPONENT", modifier: Modifier::fillMaxWidth().height(26.0).padding(start: 10.0).caption(), key: "caption")
            inline for C in reflect<*>.withAnnot<Inspectable> {
                inline if reflect<C>.annotMeta<Inspectable>.visible {
                    if studio.scene.isAlive(entity) && !storageHas<C>(storageOf<C>(studio.scene), entity) {
                        fin declared = reflect<C>.annotMeta<Inspectable>.title
                        Press("componentAdd", modifier: Modifier::fillMaxWidth().height(28.0).rounded(5.0).ghost().padding(start: 8.0, end: 8.0),
                            text: reflect<C>.declName, spacing: 8.0, key: "add-${reflect<C>.declName}") {
                            Icon(reflect<C>.annotMeta<Inspectable>.icon, studioTheme.accent, size: studioTheme.iconSize, key: "icon")
                            Label(if stringLength(declared) > 0 { declared } else { reflect<C>.declName }, app, studioTheme.text, key: "title")
                            Spacer(key: "fill")
                            Label(reflect<C>.annotMeta<Inspectable>.category, app, studioTheme.faint, size: 11.0, key: "category")
                        }
                    }
                }
            }
        }
        "addEntity" -> {
            Text("ADD ENTITY", modifier: Modifier::fillMaxWidth().height(26.0).padding(start: 10.0).caption(), key: "caption")
            var index = 0
            while index < studio.presets.size {
                fin preset = studio.presets[index].clone()
                Press("entityAdd", modifier: Modifier::fillMaxWidth().height(28.0).rounded(5.0).ghost().padding(start: 8.0, end: 8.0),
                    arg: index, spacing: 8.0, key: "preset-${index}") {
                    Icon(preset.icon, studioTheme.accent, size: studioTheme.iconSize, key: "icon")
                    Label(preset.name, app, studioTheme.text, key: "title")
                }
                index = index + 1
            }
        }
        else -> { }
    }
}

/** How tall a popup of [kind] is. */
func popupHeight(studio: Studio!, kind: String): Double {
    var rows = 0
    when kind {
        "addComponent" -> {
            fin entity = studio.selected()
            inline for C in reflect<*>.withAnnot<Inspectable> {
                inline if reflect<C>.annotMeta<Inspectable>.visible {
                    if studio.scene.isAlive(entity) && !storageHas<C>(ensureStorage<C>(studio.scene), entity) { rows = rows + 1 }
                }
            }
        }
        "addEntity" -> { rows = studio.presets.size }
        else -> { }
    }
    return 26.0 + (rows as Double) * 28.0 + 12.0
}

/** The whole window: chrome, the main dock, floating docks and any popup. */
react func describeStudio(pass: Composition!, studio: Studio&, app: App&, style: DockStyle&, main: Entity, floating: Array<Entity>&) {
    fin stamp = studio.revision + studio.dock.revision
    composeIfChanged(pass, stamp) {
        Column(modifier: Modifier::fillMaxSize().ground(), key: "studio") {
            TopBar(studio, app)
            Row(modifier: Modifier::fillMaxWidth().weight(1.0).padding(start: style.gap, end: style.gap), key: "body") {
                DockSpace(main, style, app, key: "dock-main") { panel ->
                    inline for P in reflect<*>.withAnnot<Panel> {
                        if panel == reflect<P>.declName { P(studio, app) }
                    }
                }
            }
            StatusBar(studio, app)
        }
        var index = 0
        while index < floating.size {
            Column(modifier: Modifier::fillMaxSize().fill(style.strip).rounded(style.radius + 2.0).outline(1.0, style.hairline).padding(all: 3.0), key: "float-${floating[index].id}") {
                DockSpace(floating[index], style, app, key: "dock-float") { panel ->
                    inline for P in reflect<*>.withAnnot<Panel> {
                        if panel == reflect<P>.declName { P(studio, app) }
                    }
                }
            }
            index = index + 1
        }
        if studio.popup.kind != "" {
            Column(modifier: Modifier::fillMaxSize().fill(studioTheme.raised).rounded(8.0).outline(1.0, studioTheme.hairline).padding(all: 6.0), spacing: 1.0, key: "popup") {
                popupRows(studio, app)
            }
        }
    }
}

// ── Keys ────────────────────────────────────────────────────────────────

fin keyLetters = "abcdefghijklmnopqrstuvwxyz"

/** The name a command's `key` / `hotkey` uses for the key pressed this frame, or "". */
func pressedKeyName(app: App&, injected: Int): String {
    if injected == keyBackspace || app.keyPressed(keyBackspace) { return "backspace" }
    var code = 48
    while code <= 57 {
        if injected == code || app.keyPressed(code) { return substring("0123456789", code - 48, code - 47) }
        code = code + 1
    }
    code = 65
    while code <= 90 {
        if injected == code || app.keyPressed(code) { return substring(keyLetters, code - 65, code - 64) }
        code = code + 1
    }
    return ""
}

// ── Fields ──────────────────────────────────────────────────────────────

/** Ends typing into a field, keeping what was typed. */
func commitField(studio: Studio!) {
    if !studio.focus.typing { return }
    fin entity = studio.selected()
    fin focus = studio.focus.clone()
    studio.focus = FieldFocus()
    if studio.scene.isAlive(entity) {
        if focus.numeric {
            fin number = parseNumber(focus.text, fieldNumber(studio.scene, entity, focus.component, focus.field, focus.axis))
            setFieldNumber(studio.scene, entity, focus.component, focus.field, focus.axis, number)
        } else {
            setFieldText(studio.scene, entity, focus.component, focus.field, focus.text)
        }
        studio.record(entity, focus.before, studio.scene.getParent(entity).id, "edit ${focus.field}")
    }
    studio.changed()
}

/** Typing into a focused field: characters, Backspace, Enter, Escape. */
func typeIntoField(studio: Studio!, app: App&, typed: String, injected: Int) {
    if injected == keyEscape || app.keyPressed(keyEscape) {
        studio.focus = FieldFocus()
        studio.changed()
        return
    }
    if injected == keyEnter || app.keyPressed(keyEnter) || injected == keyTab || app.keyPressed(keyTab) {
        commitField(studio)
        return
    }
    if (injected == keyBackspace || app.keyPressed(keyBackspace)) && stringLength(studio.focus.text) > 0 {
        studio.focus.text = substring(studio.focus.text, 0, stringLength(studio.focus.text) - 1)
        studio.changed()
    }
    if typed != "" {
        studio.focus.text = "${studio.focus.text}${typed}"
        studio.changed()
    }
}

// ── Layout persistence ──────────────────────────────────────────────────

fin layoutFile = ".azora/layout.azon"

func saveLayout(studio: Studio!, world: World!) {
    azsProjectMakeDir(studio.editor.project, ".azora")
    fin buffer = azsBufferNew(writeDockLayout(world))
    if buffer == Long(0) { return }
    azsProjectWrite(studio.editor.project, layoutFile, buffer)
    azsBufferClose(buffer)
}

/** Removes every dock entity, so a layout can be built afresh. */
func clearLayout(world: World!) {
    while storageLength<DockNode>(ensureStorage<DockNode>(world)) > 0 {
        fin entity = storageEntityAt<DockNode>(ensureStorage<DockNode>(world), 0)
        if world.isAlive(entity) { world.despawn(entity) } else { storageRemove<DockNode>(ensureStorage<DockNode>(world), entity) }
    }
}

/** Reads a host file into text; "" when it cannot be read. */
func readText(project: Long, path: String): String {
    fin buffer = azsProjectRead(project, path)
    if buffer == Long(0) { return "" }
    fin text = "${azsBufferText(buffer)} "
    azsBufferClose(buffer)
    return substring(text, 0, stringLength(text) - 1)
}

// ── The frame ───────────────────────────────────────────────────────────

react func main() {
    if azsAbiVersion() != 1 { println("incompatible Studio host ABI")
        return }
    fin root = azsEnvironment("AZORA_STUDIO_PROJECT")
    fin project = azsProjectOpen(root, 0)
    if project == Long(0) { println(azsError())
        return }
    fin source = azsProjectRead(project, "src/main.az")
    if source == Long(0) { azsProjectClose(project)
        println(azsError())
        return }
    var studio = Studio(root, editorOf(project, source))
    studio.nameProject(root)

    // Studio's own data: the theme, entity presets and the default scene.
    fin resourcesRoot = azsEnvironment("AZORA_STUDIO_RESOURCES")
    fin resources = if resourcesRoot != "" { azsProjectOpen(resourcesRoot, 0) } else { Long(0) }
    if resources != Long(0) {
        loadTheme(readText(resources, "theme.azon"))
        studio.fileKinds = readFileKinds(readText(resources, "file-types.azon"))
        fin presets = readPresets(readText(resources, "presets.azon"))
        var index = 0
        while index < presets.size {
            studio.presets.add(presets[index].clone())
            index = index + 1
        }
    }

    // The scene: the project's own, or the default one when it has none of this version.
    if readScene(studio.scene, readText(project, sceneFile)) < 0 {
        if resources != Long(0) && readScene(studio.scene, readText(resources, "default-scene.azscene")) >= 0 {
            studio.sceneDirty = true
            studio.output("Azora Studio — native build.\nThis project's scene predates scene format 2; it opened with the default scene. Save (⌘S) to keep it.")
        }
    } else {
        studio.output("Azora Studio — native build.\nOpened ${studio.projectName()} · ${sceneFile}")
    }
    if resources != Long(0) { azsProjectClose(resources) }
    var id = 0
    while id < studio.scene.entityCount {
        fin entity = studio.scene.entityAt(id)
        if studio.scene.isAlive(entity) {
            storageInsert<Expanded>(ensureStorage<Expanded>(studio.scene), entity, Expanded())
        }
        id = id + 1
    }
    var first = Entity::invalid
    id = 0
    while id < studio.scene.entityCount && !studio.scene.isAlive(first) {
        if studio.scene.isAlive(studio.scene.entityAt(id)) && storageHas<Mesh3d>(ensureStorage<Mesh3d>(studio.scene), studio.scene.entityAt(id)) {
            first = studio.scene.entityAt(id)
        }
        id = id + 1
    }
    studio.select(first)
    studio.refreshAssets()
    studio.message("Ready")

    var world = World()
    var pass = Composition::of(world, "studio")
    if !readDockLayout(pass.world, readText(project, layoutFile)) {
        dockDefaultLayout(pass.world)
    }

    var app = appInit("Azora Studio", 1520, 940)
    if !app.ok { return }
    app.setClearColor(studioTheme.ground.r, studioTheme.ground.g, studioTheme.ground.b)
    studio.meshes = app.primitiveMeshes()
    // The icons every part draws, from the atlas tools/build-icons.sh renders.
    if resourcesRoot != "" {
        studio.logo = app.loadImage("${resourcesRoot}/azora-logo.png").texture
        fin atlasFiles = azsProjectOpen(resourcesRoot, 0)
        if atlasFiles != Long(0) {
            if loadIconAtlas(app, pass.world, "${resourcesRoot}/icons.png", readText(atlasFiles, "icons-index.azon")) {
                studio.icons = storageValueAt<IconAtlas>(ensureStorage<IconAtlas>(pass.world), 0).clone()
            } else {
                studio.output("The icon atlas in ${resourcesRoot} could not be read.")
            }
            azsProjectClose(atlasFiles)
        }
    }
    fin style = dockStyle()

    fin frameLimit = azsEnvironmentInt("AZORA_STUDIO_FRAME_LIMIT")
    fin started = azsMonotonicSeconds()
    var frames = 0
    var layoutVersion = Long(-1)
    var lastWidth: Double = -1.0
    var lastHeight: Double = -1.0
    var mainPaint = PaintList()
    var floatPaint = PaintList()
    var popupPaint = PaintList()
    var paintVersion = Long(-1)
    var lastX: Double = 0.0
    var lastY: Double = 0.0
    var wasDown = false
    var wasMiddleDown = false
    var scrubMoved = false
    var dragPanel: String = ""
    var player = ScriptPlayer::open()
    var floating: Array<Entity> = Array<Entity>()
    fin tracing = azsEnvironment("AZORA_STUDIO_TRACE") != ""
    studio.tracing = tracing

    while app.frame() {
        frames = frames + 1
        var input = FrameInput()
        var typed = app.textInput()
        // A script drives the window through the same paths as a user.
        fin cue = player.next(app, frames)
        if cue.typed != "" { typed = cue.typed }
        fin injectedKey = cue.key
        fin injectedMeta = cue.meta
        fin scriptCommand = cue.command

        if player.pointing {
            input.x = player.x
            input.y = player.y
            input.down = player.down || cue.click
            input.rightDown = player.rightDown
            input.scrollY = cue.scroll
        } else {
            input.x = app.mouseX()
            input.y = app.mouseY()
            // A tap can go down and up between two frames; it still counts as
            // held for the frame it happened in, so it presses and releases.
            input.down = app.mouseDown(mouseLeft) || app.mouseClicked(mouseLeft)
            input.rightDown = app.mouseDown(mouseRight) || app.mouseClicked(mouseRight)
            input.middleDown = app.mouseDown(mouseMiddle) || app.mouseClicked(mouseMiddle)
            input.scrollX = app.scrollX()
            input.scrollY = app.scrollY()
            input.preciseScroll = app.scrollIsPrecise()
            input.pinch = app.pinch()
        }
        input.middlePressed = input.middleDown && !wasMiddleDown
        wasMiddleDown = input.middleDown
        input.seconds = app.deltaTime()
        input.flyForward = keyAxis(app, keyW, keyS)
        input.flyRight = keyAxis(app, keyD, keyA)
        input.flyUp = keyAxis(app, keyE, keyQ)
        input.pressed = input.down && !wasDown
        input.released = !input.down && wasDown
        input.rightPressed = if player.pointing { cue.rightClick } else { app.mouseClicked(mouseRight) }
        input.dx = if frames == 1 { 0.0 } else { input.x - lastX }
        input.dy = if frames == 1 { 0.0 } else { input.y - lastY }
        input.shift = app.keyDown(keyShift)
        input.alt = app.keyDown(keyAlt)
        input.command = app.keyDown(keyMeta) || injectedMeta
        if tracing && (app.mouseClicked(mouseLeft) || input.pressed || input.released) {
            println("pointer ${formatDecimal(input.x, 1)},${formatDecimal(input.y, 1)} clicked ${app.mouseClicked(mouseLeft)} down ${input.down} pressed ${input.pressed} released ${input.released}")
        }
        lastX = input.x
        lastY = input.y
        wasDown = input.down && !cue.click
        studio.pointerX = input.x
        studio.pointerY = input.y

        if scriptCommand != "" {
            if !runCommand(studio, scriptCommand, Invocation()) { studio.notify("No command '${scriptCommand}'", 3) }
        }

        // ── Keys: ⌘ chords and hotkeys run commands.
        if input.command {
            fin name = pressedKeyName(app, injectedKey)
            if name != "" {
                fin command = commandForKey(name, input.shift)
                if command != "" && !(studio.sourceFocused && (name == "a" || name == "c" || name == "x" || name == "v")) {
                    runCommand(studio, command, Invocation())
                }
            }
        } else if studio.focus.typing {
            typeIntoField(studio, app, typed, injectedKey)
            typed = ""
        } else if !studio.sourceFocused && studio.viewDrag != 1 {
            if injectedKey == keyEscape || app.keyPressed(keyEscape) {
                studio.popup = Popup()
                studio.changed()
            }
            fin name = pressedKeyName(app, injectedKey)
            if name != "" {
                fin command = commandForHotkey(name)
                if command != "" { runCommand(studio, command, Invocation()) }
            }
        } else if injectedKey == keyEscape || app.keyPressed(keyEscape) {
            studio.sourceFocused = false
            studio.changed()
        }

        // ── Wheel: the Engine's scroll system moves whichever scrollable the
        // pointer is over; a panel scrolls because it holds [Scroll].
        if input.scrollY != 0.0 && pass.applyScroll(input.x, input.y, 0.0 - input.scrollY, 0.0) > 0 { studio.changed() }

        // ── Pointer, front to back.
        var consumed = false
        if studio.popup.kind != "" && input.pressed {
            fin hit = popupPaint.topmost<Pressable>(store<Pressable>(pass), input.x, input.y)
            if hit.isValid {
                fin press = storageGetOrDefault<Pressable>(store<Pressable>(pass), hit, Pressable())
                runCommand(studio, press.command, Invocation(press.target, press.arg, 0.0, press.text))
            } else {
                studio.popup = Popup()
                studio.changed()
            }
            consumed = true
        }
        if !consumed && studio.viewDrag != 0 && dragPanel != "" {
            var rect = ViewRect()
            var index = 0
            while index < storageLength<PanelSurface>(store<PanelSurface>(pass)) {
                fin node = storageEntityAt<PanelSurface>(store<PanelSurface>(pass), index)
                if storageGetOrDefault<PanelSurface>(store<PanelSurface>(pass), node, PanelSurface()).panel == dragPanel {
                    fin area = storageGetOrDefault<Rect>(store<Rect>(pass), node, Rect())
                    rect = ViewRect(area.x, area.y, area.width, area.height)
                }
                index = index + 1
            }
            canvasPointer(dragPanel, app, studio, rect, input)
            if studio.viewDrag == 0 { dragPanel = "" }
            consumed = true
        }
        if !consumed {
            consumed = dockPointer(studio.dock, pass, floatPaint, mainPaint, style, input.x, input.y, input.pressed, input.down)
        }
        if tracing && input.pressed {
            println("after dock: consumed ${consumed} popup '${studio.popup.kind}' viewDrag ${studio.viewDrag} panel '${dragPanel}'")
            var handle = 0
            while handle < mainPaint.nodes.size {
                fin n = mainPaint.nodes[handle]
                if storageHas<DockSplitHandle>(store<DockSplitHandle>(pass), n.entity) {
                    println("  split handle ${formatDecimal(n.x, 1)},${formatDecimal(n.y, 1)} ${formatDecimal(n.width, 1)}x${formatDecimal(n.height, 1)}")
                }
                handle = handle + 1
            }
        }
        if !consumed && studio.focus.scrubbing {
            fin entity = studio.selected()
            if input.down {
                fin delta = input.x - studio.focus.startX
                if absValue(delta) > 2.0 { scrubMoved = true }
                if scrubMoved && studio.scene.isAlive(entity) {
                    fin steps = (delta / 3.0) as Int
                    setFieldNumber(studio.scene, entity, studio.focus.component, studio.focus.field, studio.focus.axis,
                        studio.focus.startValue + (steps as Double) * studio.focus.step)
                    studio.changed()
                }
            } else {
                studio.focus.scrubbing = false
                if scrubMoved {
                    studio.record(entity, studio.focus.before, studio.scene.getParent(entity).id, "edit ${studio.focus.field}")
                    studio.focus = FieldFocus()
                } else {
                    // A click without a drag types into the field.
                    studio.focus.typing = true
                    studio.focus.text = formatDecimal(fieldNumber(studio.scene, entity, studio.focus.component, studio.focus.field, studio.focus.axis), 4)
                }
                studio.changed()
            }
            consumed = true
        }
        if !consumed && input.pressed {
            var hitField = floatPaint.topmost<FieldTarget>(store<FieldTarget>(pass), input.x, input.y)
            if !hitField.isValid { hitField = mainPaint.topmost<FieldTarget>(store<FieldTarget>(pass), input.x, input.y) }
            var hitPress = floatPaint.topmost<Pressable>(store<Pressable>(pass), input.x, input.y)
            if !hitPress.isValid { hitPress = mainPaint.topmost<Pressable>(store<Pressable>(pass), input.x, input.y) }
            if tracing {
                fin traced = storageGetOrDefault<Pressable>(store<Pressable>(pass), hitPress, Pressable())
                println("hit field ${hitField.isValid} press ${hitPress.isValid} '${traced.command}' paint ops ${mainPaint.ops.size} pressables ${storageLength<Pressable>(store<Pressable>(pass))}")
                var probe = 0
                while probe < mainPaint.nodes.size {
                    fin n = mainPaint.nodes[probe]
                    if input.x >= n.x && input.x < n.x + n.width && input.y >= n.y && input.y < n.y + n.height {
                        println("  node ${n.entity.id} rect ${formatDecimal(n.x, 0)},${formatDecimal(n.y, 0)} ${formatDecimal(n.width, 0)}x${formatDecimal(n.height, 0)} clip ${formatDecimal(n.clipTop, 0)}..${formatDecimal(n.clipBottom, 0)} press ${storageHas<Pressable>(store<Pressable>(pass), n.entity)}")
                    }
                    probe = probe + 1
                }
            }
            if studio.focus.typing {
                fin binding = storageGetOrDefault<FieldTarget>(store<FieldTarget>(pass), hitField, FieldTarget())
                if !hitField.isValid || binding.component != studio.focus.component || binding.field != studio.focus.field || binding.axis != studio.focus.axis {
                    commitField(studio)
                }
            }
            if hitField.isValid && !studio.focus.typing {
                fin binding = storageGetOrDefault<FieldTarget>(store<FieldTarget>(pass), hitField, FieldTarget())
                fin entity = studio.selected()
                studio.sourceFocused = false
                if binding.numeric {
                    studio.focus = FieldFocus(binding.component, binding.field, binding.axis, false, true, "", input.x,
                        fieldNumber(studio.scene, entity, binding.component, binding.field, binding.axis),
                        fieldStep(binding.component, binding.field), studio.snapshot(entity), true)
                    scrubMoved = false
                } else {
                    fin current = if binding.component == "Name" { studio.nameOf(entity) } else { "" }
                    studio.focus = FieldFocus(binding.component, binding.field, 0, true, false, current, input.x, 0.0, 0.0, studio.snapshot(entity), false)
                }
                studio.changed()
                consumed = true
            } else if hitPress.isValid {
                fin press = storageGetOrDefault<Pressable>(store<Pressable>(pass), hitPress, Pressable())
                runCommand(studio, press.command, Invocation(press.target, press.arg, 0.0, press.text))
                consumed = true
            }
        }
        if !consumed {
            var surface = floatPaint.topmost<PanelSurface>(store<PanelSurface>(pass), input.x, input.y)
            if !surface.isValid { surface = mainPaint.topmost<PanelSurface>(store<PanelSurface>(pass), input.x, input.y) }
            if surface.isValid {
                fin panel = storageGetOrDefault<PanelSurface>(store<PanelSurface>(pass), surface, PanelSurface()).panel
                fin area = storageGetOrDefault<Rect>(store<Rect>(pass), surface, Rect())
                if input.pressed && panel != "CodePanel" && studio.sourceFocused {
                    studio.sourceFocused = false
                    studio.changed()
                }
                if canvasPointer(panel, app, studio, ViewRect(area.x, area.y, area.width, area.height), input) {
                    if studio.viewDrag != 0 { dragPanel = panel }
                }
            }
        }

        // ── Text into the source editor.
        fin previousCursor = studio.cursor
        if studio.sourceFocused && !studio.focus.typing {
            if editKeys(app, studio, typed, injectedKey, input.command) {
                studio.lastEdit = app.timeNow()
                if !studio.problemsStale && studio.problems.size > 0 { studio.problemsStale = true }
                studio.changed()
            }
        }
        if studio.cursor != previousCursor {
            studio.revealCursor = true
            studio.lastEdit = app.timeNow()
        }
        studio.syncSource(sourceRow(studio.editor.source, studio.cursor) + 1,
            columnsBetween(studio.editor.source, lineStartOf(studio.editor.source, studio.cursor), studio.cursor) + 1,
            lineCount(studio.editor.source))

        // ── Requests commands left for the window.
        if studio.resetLayout {
            studio.resetLayout = false
            clearLayout(pass.world)
            dockDefaultLayout(pass.world)
            studio.dock.changed()
        }
        if studio.showPanel != "" {
            fin tab = dockFindPanel(pass.world, studio.showPanel)
            if pass.world.isAlive(tab) { dockActivate(pass.world, tab) }
            else {
                fin roots = dockRoots(pass.world)
                if roots.size > 0 {
                    fin group = dockFirstGroup(pass.world, roots[0])
                    if pass.world.isAlive(group) { dockAddTab(pass.world, group, studio.showPanel) }
                }
            }
            studio.showPanel = ""
            studio.dock.changed()
        }
        if studio.layoutDirty {
            studio.layoutDirty = false
            saveLayout(studio, pass.world)
        }

        // ── Build, check and run go through the native compiler.
        if frames == 3 && studio.requestedTool == "" { studio.requestedTool = "inspect" }
        fin compiler = azsEnvironment("AZORA_NATIVE_COMPILER")
        if studio.requestedTool != "" && studio.process == Long(0) {
            fin action = studio.requestedTool
            studio.requestedTool = ""
            if compiler == "" {
                studio.notify("Set AZORA_NATIVE_COMPILER to build, check and run", 3)
            } else if studio.editor.save() {
                studio.process = azsProcessStart(compiler, root, root, action)
                if studio.process == Long(0) { studio.notify(azsError(), 3) }
                else {
                    studio.processAction = action
                    studio.busy = true
                    if action != "inspect" { studio.output("$ azora ${action}\n") }
                    studio.notify(when action {
                        "inspect" -> "Checking src/main.az…"
                        "play" -> "Building and running the app…"
                        else -> "Building with the native compiler…"
                    }, 1)
                }
            } else { studio.notify(azsError(), 3) }
        }
        if studio.process != Long(0) {
            fin result = azsProcessPoll(studio.process)
            if result != -1 {
                fin output = azsProcessOutput(studio.process)
                if studio.processAction == "inspect" && isInspectSnapshot(output) {
                    studio.inspect(output, "src/main.az")
                    fin count = studio.problems.size
                    if count == 0 { studio.notify("No problems", 2) }
                    else { studio.notify(if count == 1 { "1 problem in src/main.az" } else { "${count} problems in src/main.az" }, if studio.countProblems(0) > 0 { 3 } else { 1 }) }
                } else {
                    studio.output(if output == "" { "$ azora ${studio.processAction}\n(no output)" } else { "$ azora ${studio.processAction}\n${output}" })
                    if result == 0 { studio.notify(when studio.processAction {
                        "play" -> "Run finished"
                        "build" -> "Build succeeded"
                        else -> "Check finished"
                    }, 2) }
                    else { studio.notify("${studio.processAction} failed (exit ${result})", 3) }
                }
                azsProcessClose(studio.process)
                studio.process = Long(0)
                studio.busy = false
                studio.changed()
            }
        }
        if studio.playing && !studio.paused { studio.playTime = studio.playTime + app.deltaTime() }

        // ── Compose, arrange, paint.
        floating = dockRoots(pass.world)
        fin main = if floating.size > 0 { floating.removeAt(0) } else { Entity::invalid }
        var floatRoots: Array<Entity> = Array<Entity>()
        var index = 0
        while index < floating.size {
            if storageGetOrDefault<DockRoot>(store<DockRoot>(pass), floating[index], DockRoot()).floating { floatRoots.add(floating[index]) }
            index = index + 1
        }
        describeStudio(pass, studio, app, style, main, floatRoots)
        fin rootNode = pass.findChild(pass.root, "studio")
        fin popupNode = pass.findChild(pass.root, "popup")
        fin width = app.width() as Double
        fin height = app.height() as Double
        if pass.version != layoutVersion || width != lastWidth || height != lastHeight {
            pass.arrange(rootNode, 0.0, 0.0, width, height)
            index = 0
            while index < floatRoots.size {
                fin bounds = storageGetOrDefault<DockRoot>(store<DockRoot>(pass), floatRoots[index], DockRoot())
                fin node = pass.findChild(pass.root, "float-${floatRoots[index].id}")
                if node.isValid { pass.arrange(node, bounds.x, bounds.y, bounds.width, bounds.height) }
                index = index + 1
            }
            if popupNode.isValid {
                var x = studio.popup.x
                var y = studio.popup.y + 6.0
                fin h = popupHeight(studio, studio.popup.kind)
                if x + 280.0 > width { x = width - 288.0 }
                if y + h > height { y = height - h - 8.0 }
                pass.arrange(popupNode, x, y, 280.0, h)
            }
            layoutVersion = pass.version
            lastWidth = width
            lastHeight = height
            paintVersion = Long(-1)
        }
        if paintVersion != layoutVersion {
            mainPaint.clear()
            floatPaint.clear()
            popupPaint.clear()
            recordTree(app, pass, rootNode, 0.0, height, mainPaint)
            index = 0
            while index < floatRoots.size {
                fin node = pass.findChild(pass.root, "float-${floatRoots[index].id}")
                if node.isValid { recordTree(app, pass, node, 0.0, height, floatPaint) }
                index = index + 1
            }
            if popupNode.isValid { recordTree(app, pass, popupNode, 0.0, height, popupPaint) }
            paintVersion = layoutVersion
        }
        replayPaint(app, mainPaint)
        drawCanvases(app, studio, pass, rootNode)
        replayPaint(app, floatPaint)
        index = 0
        while index < floatRoots.size {
            fin node = pass.findChild(pass.root, "float-${floatRoots[index].id}")
            if node.isValid { drawCanvases(app, studio, pass, node) }
            index = index + 1
        }
        replayPaint(app, popupPaint)
        dockOverlay(app, studio.dock, pass, style)
        app.present()

        // A scripted screenshot captures this window as just presented.
        player.capture(app, root, cue.shot)
        if frameLimit > 0 && frames >= frameLimit { app.quit() }
    }
    if tracing {
        var slot = 0
        while slot < pass.world.storages.size {
            fin size = storageLength<Any>(pass.world.storages[slot] as Storage<Any>&)
            println("ui storage ${pass.world.storageNames[slot]} ${size}")
            slot = slot + 1
        }
        println("ui entities ${pass.world.entityCount} alive ${pass.world.aliveCount}")
    }
    saveLayout(studio, pass.world)
    player.close()
    app.releasePrimitives(studio.meshes)
    pass.dispose()
    app.shutdown()
    purge studio
    println("frames ${frames}")
    if frames > 0 { println("mean frame interval seconds ${(azsMonotonicSeconds() - started) / (frames as Double)}") }
    println("peak resident bytes ${azsPeakMemoryBytes()}")
    if azsLiveHandles() != 0 { println("native handle leak")
        azsExit(1) }
}
