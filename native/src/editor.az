module studio.editor
import std.string
import std.serializer
import std.container.list
import studio.host

/** Copies the template's package configuration and names its project after the destination. */
func namedManifest(root: String, project: Long): String {
    fin manifest = azsProjectRead(project, "azora.azon")
    if manifest == 0 then return ""
    defer { azsBufferClose(manifest) }
    fin path = split(root, "/")
    fin name = path[path.size - 1]
    fin data = decodeSerialValue(azsBufferText(manifest), serializerOptions()) catch SerialValue.Null
    var fields = arrayListOf<SerialField>()
    var details = arrayListOf<SerialField>()
    when data {
        .Object(members) -> {
            for member in members {
                if member.name == "project" {
                    when member.value {
                        .Object(original) -> { for field in original { if field.name != "name" then details.add(take field) } }
                        else -> { }
                    }
                } else { fields.add(take member) }
            }
        }
        else -> return ""
    }
    details.add(SerialField("name", SerialValue.Text(name)))
    fields.add(SerialField("project", SerialValue.Object(take details)))
    return encodeSerialValue(SerialValue.Object(take fields), serializerOptions()) catch ""
}

func createNativeProject(root: String, template: String = ""): Bool {
    if template != "" {
        fin project = azsProjectOpen(template, 0)
        if project == 0 then return false
        defer { azsProjectClose(project) }
        fin files = projectFiles(project)
        return azsProjectFromTemplateWithEntry(root, template, namedManifest(root, project), files.source) != 0
    }
    fin source = azsBufferNew("import std.io\nfunc main() { println(\"Azora native project\") }\n")
    if source == 0 then return false
    fin project = azsProjectOpen(root, 1)
    if project == 0 {
        azsBufferClose(source)
        return false
    }
    fin manifest = azsBufferNew("{\"project\":{\"name\":\"native-project\",\"version\":\"0.1.0\",\"entry\":\"main.az\",\"src\":\"src\",\"targets\":[\"llvm\"]}}\n")
    var saved: Bool = false
    if manifest != 0 {
        saved = azsProjectWrite(project, "azora.azon", manifest) != 0 &&
            azsProjectWrite(project, "src/main.az", source) != 0
    }
    azsBufferClose(source)
    if manifest != 0 then azsBufferClose(manifest)
    azsProjectClose(project)
    return saved
}

// Application state and history live in Azora. Each nonzero host handle has one
// owner here; views returned by host calls are used only before their next edit.
// History keeps independent buffers, never references into a replaced source
// buffer, and is bounded so a long session cannot grow without limit.
pack Editor {
    var project: Long
    var source: Long
    var history: Array<Long>
    var future: Array<Long>
    var dirty: Bool
    /** Where a run of typing ends, so the next keystroke can extend it; -1 when none. */
    var typingEnd: Int = -1
    /** The project file this edits. */
    var path: String = "src/main.az"
}

/**
 * An open file that is not the one being edited: its buffers and where its
 * caret was. Studio swaps it with the [Editor]'s when its tab is used.
 */
pack OpenFile derives Clone {
    var path: String = ""
    var source: Long = 0
    var history: Array<Long> = []
    var future: Array<Long> = []
    var dirty: Bool = false
    var typingEnd: Int = -1
    var cursor: Int = 0
    var anchor: Int = -1
    var scroll: Int = 0
}

/** The entry source of a project whose azora.azon names none. */
inline fin defaultEntrySource: String = "src/main.az"

/** The entry files and display name from the project's manifest. */
pack ProjectFiles {
    fin source: String
    fin scene: String = "scene.azscene"
    fin name: String = ""
}

func isProjectScenePath(path: String): Bool = endsWith(path, ".azscene") &&
    !startsWith(path, "/") && indexOf(path, "..") < 0 && indexOf(path, "\\") < 0

/** Reads the project's source directory, entry filename and optional startup scene from azora.azon. */
func projectFiles(project: Long): ProjectFiles {
    fin manifest = azsProjectRead(project, "azora.azon")
    if manifest == 0 then return .(defaultEntrySource)
    defer { azsBufferClose(manifest) }
    fin data = decodeSerialValue(azsBufferText(manifest), serializerOptions()) catch SerialValue.Null
    var folder = "src"
    var entry = "main.az"
    var scene = "scene.azscene"
    var name = ""
    when data {
        .Object(members) -> {
            for member in members {
                if member.name == "project" {
                    when member.value {
                        .Object(fields) -> {
                            for field in fields {
                                when field.value {
                                    .Text(text) -> {
                                        if field.name == "entry" && endsWith(text, ".az") && indexOf(text, "/") < 0 then entry = text
                                        if field.name == "src" && text != "" && indexOf(text, "..") < 0 && !startsWith(text, "/") then folder = text
                                        if field.name == "scene" && isProjectScenePath(text) then scene = text
                                        if field.name == "name" then name = trim(text)
                                    }
                                    else -> { }
                                }
                            }
                        }
                        else -> { }
                    }
                }
            }
        }
        else -> { }
    }
    return .("${folder}/${entry}", "${scene}", name)
}

/** What starts the dock panel name of a tab editing another project file. */
inline fin filePanelPrefix: String = "file:"

/** The dock panel that edits project file [path]. */
func documentPanel(path: String, entry: String): String = if path == entry then "CodePanel" else "${filePanelPrefix}${path}"

/** The project file dock [panel] edits, or "" when it edits none. */
func panelDocument(panel: String, entry: String): String = when {
    panel == "CodePanel" -> entry
    startsWith(panel, filePanelPrefix) -> substring(panel, stringLength(filePanelPrefix), stringLength(panel))
    else -> ""
}

/** How many edits undo can walk back. */
inline fin editorHistoryLimit: Int = 256

func editorOf(project: Long, source: Long): Editor = .(project, source, [], [], false)

func closeBuffers(buffers: Array<Long>!): Unit {
    while buffers.size > 0 then azsBufferClose(buffers.removeLast())
}

/** Moves every buffer of [from], in order, onto the end of [to]. */
func moveBuffers(from: Array<Long>!, to: Array<Long>!): Unit {
    for buffer in from then to.add(buffer)
    while from.size > 0 then from.removeLast()
}

impl Editor {
    /** Makes [next] the source, keeping the replaced one for undo. */
    func !.commit(next: Long) {
        self.typingEnd = -1
        self.history.add(self.source)
        if self.history.size > editorHistoryLimit then azsBufferClose(self.history.removeAt(0))
        closeBuffers(self.future)
        self.source = next
        self.dirty = true
    }
    func !.editByte(offset: Int, remove: Int, value: Int): Bool {
        fin next = azsBufferSpliceByte(self.source, offset, remove, value)
        if next == 0 then return false
        self.commit(next)
        return true
    }
    /**
     * Types [text] at [offset]. Keystrokes that continue a word share one
     * undo step; a space or a new line starts the next one. Answers the
     * inserted byte length, or -1.
     */
    func !.typeText(offset: Int, text: String): Int {
        if offset != self.typingEnd || self.history.size == 0 || text == " " {
            fin length = self.splice(offset, 0, text)
            if length >= 0 then self.typingEnd = offset + length
            return length
        }
        fin size = azsBufferSize(self.source)
        if offset > size then return -1
        fin before = azsBufferSlice(self.source, 0, offset)
        if before == 0 then return -1
        fin after = azsBufferSlice(self.source, offset, size)
        if after == 0 {
            azsBufferClose(before)
            return -1
        }
        fin next = azsBufferNew("${azsBufferText(before)}${text}${azsBufferText(after)}")
        azsBufferClose(before)
        azsBufferClose(after)
        if next == 0 then return -1
        fin length = azsBufferSize(next) - size
        // The run's starting state is already the newest undo entry.
        azsBufferClose(self.source)
        closeBuffers(self.future)
        self.source = next
        self.dirty = true
        self.typingEnd = offset + length
        return length
    }

    /** Replaces [remove] bytes at [offset] with [text]; one undo step. Answers the inserted byte length, or -1. */
    func !.splice(offset: Int, remove: Int, text: String): Int {
        fin size = azsBufferSize(self.source)
        if offset < 0 || remove < 0 || offset + remove > size then return -1
        fin before = azsBufferSlice(self.source, 0, offset)
        if before == 0 then return -1
        fin after = azsBufferSlice(self.source, offset + remove, size)
        if after == 0 {
            azsBufferClose(before)
            return -1
        }
        fin inserted = azsBufferNew(text)
        if inserted == 0 {
            azsBufferClose(before)
            azsBufferClose(after)
            return -1
        }
        fin length = azsBufferSize(inserted)
        azsBufferClose(inserted)
        fin next = azsBufferNew("${azsBufferText(before)}${text}${azsBufferText(after)}")
        azsBufferClose(before)
        azsBufferClose(after)
        if next == 0 then return -1
        self.commit(next)
        return length
    }

    func !.replace(text: String): Bool {
        fin next = azsBufferNew(text)
        if next == 0 then return false
        self.commit(next)
        return true
    }

    func !.undo(): Bool {
        self.typingEnd = -1
        if self.history.size == 0 then return false
        self.future.add(self.source)
        self.source = self.history.removeLast()
        self.dirty = true
        return true
    }

    func !.redo(): Bool {
        self.typingEnd = -1
        if self.future.size == 0 then return false
        self.history.add(self.source)
        self.source = self.future.removeLast()
        self.dirty = true
        return true
    }

    func !.save(): Bool {
        if azsProjectWrite(self.project, self.path, self.source) == 0 then return false
        self.dirty = false
        return true
    }

    // Reload is transactional: failure leaves source and history intact.
    func !.reopen(): Bool {
        fin next = azsProjectRead(self.project, self.path)
        if next == 0 then return false
        azsBufferClose(self.source)
        closeBuffers(self.history)
        closeBuffers(self.future)
        self.source = next
        self.dirty = false
        return true
    }

    dtor .() {
        if self.source != 0 then azsBufferClose(self.source)
        closeBuffers(self.history)
        closeBuffers(self.future)
        if self.project != 0 then azsProjectClose(self.project)
    }
}
