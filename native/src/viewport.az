// The scene viewport: the Engine renders the scene into the panel's surface,
// and the gizmos package draws the grid, the handles and the axis widget over
// it. Picking casts the pointer's ray into each entity's own space, so a
// rotated or scaled primitive is hit where it is drawn.

@Panel(title: "Scene", icon: "box", area: .Center, order: 0, closable: false)
@Canvas
impl pack ScenePanel {
    react ctor (anchor: Anchor!).(studio: Studio&, app: App&): Entity {
        return Column(modifier: ::fillMaxSize(), key: "scene") {
            PanelBar {
                BarButton("toolSelect", app, icon: "mouse-pointer-2", active: studio.tool == 0, key: "select")
                BarButton("toolMove", app, icon: "move", active: studio.tool == 1, key: "move")
                BarButton("toolRotate", app, icon: "rotate-3d", active: studio.tool == 2, key: "rotate")
                BarButton("toolScale", app, icon: "scale-3d", active: studio.tool == 3, key: "scale")
                Divider(key: "divider")
                BarButton("viewToggle2d", app, label: if studio.mode3d then "3D" else "2D", active: true, key: "mode")
                BarButton("viewLit", app, label: "Lit", active: studio.viewMode == 0, key: "lit")
                BarButton("viewUnlit", app, label: "Unlit", active: studio.viewMode == 1, key: "unlit")
                BarButton("viewWireframe", app, label: "Wireframe", active: studio.viewMode == 2, key: "wire")
                Divider(key: "quality-divider")
                Press("viewportQualityMenu", modifier: ::width(102.0).height(26.0).rounded(6.0).raised()
                    .hoverFill(studioTheme.hover.withAlpha(0.12)).padding(start: 7.0, end: 7.0), spacing: 5.0, key: "quality") {
                    Icon("sliders-horizontal", studioTheme.muted, size: studioTheme.iconSmall, key: "quality-icon")
                    Label(viewportQualityLabel(studio.viewportQuality), app, studioTheme.text, key: "quality-label")
                    Spacer(key: "fill")
                    Icon("chevron-down", studioTheme.muted, size: studioTheme.iconSmall, key: "arrow")
                }
                Spacer(key: "fill")
                fin sky = viewSkyEntity(studio)
                if sky.isValid {
                    fin physical = storageHas<AetherSky>(storageOf(studio.scene),sky)
                    fin hour = if physical then storageGet<AetherSky>(storageOf(studio.scene),sky).hour
                        else storageGet<SkyEnvironment>(storageOf(studio.scene),sky).hour
                    Text("Hour", modifier: ::width(30.0).fontSize(11.0).mutedText(), key: "sky-label")
                    Row(modifier: ::width(68.0).height(26.0), key: "sky-time") {
                        NumberField("SkyTime", "hour", 0, hour, studio.focus, key: "hour")
                    }
                }
                // The camera's flying speed, as Unreal's camera speed: typed here, or
                // turned with the wheel while the right button flies the view.
                Icon("video", studioTheme.muted, size: studioTheme.iconSmall, key: "speed-icon")
                Row(modifier: ::width(58.0).height(26.0), key: "speed") {
                    NumberField("CameraSpeed", "speed", 0, studio.camera.speed, studio.focus, key: "value")
                }
                Text("m/s", modifier: ::width(26.0).fontSize(11.0).mutedText(), key: "speed-unit")
                BarButton("viewFocus", app, icon: "focus", label: "Focus", key: "focus")
            }
            Surface("ScenePanel", studioTheme.viewport)
        }
    }

    func draw(app: App!, studio: Studio!, rect: ViewRect&) {
        drawViewport(app, studio, rect)
    }

    func pointer(app: App!, studio: Studio!, rect: ViewRect&, input: FrameInput&): Bool = viewportPointer(app, studio, rect, input)
}

func viewSkyEntity(studio: Studio&): Entity {
    fin physical = storageOf<AetherSky>(studio.scene)
    var at = 0
    while at < storageLength<AetherSky>(physical) {
        fin entity = storageEntityAt<AetherSky>(physical,at)
        if physical.values[at].enabled && studio.scene.isAlive(entity) then return entity
        at++
    }
    fin skies = storageOf<SkyEnvironment>(studio.scene)
    var index = 0
    while index < storageLength<SkyEnvironment>(skies) {
        fin entity = storageEntityAt<SkyEnvironment>(skies, index)
        if skies.values[index].enabled && studio.scene.isAlive(entity) then return entity
        index++
    }
    return ::invalid
}

/** The hour the viewport's sky shows: the physical sky's, or the simple sky's. */
func viewportSkyHour(studio: Studio&): Double {
    fin sky = viewSkyEntity(studio)
    return when {
        !studio.scene.isAlive(sky) -> 0.0
        storageHas<AetherSky>(storageOf(studio.scene), sky) -> storageGet<AetherSky>(storageOf(studio.scene), sky).hour
        storageHas<SkyEnvironment>(storageOf(studio.scene), sky) -> storageGet<SkyEnvironment>(storageOf(studio.scene), sky).hour
        else -> 0.0
    }
}

func setViewportSkyHour(studio: Studio!, text: String) {
    fin entity = viewSkyEntity(studio)
    if !studio.scene.isAlive(entity) then return
    fin before = studio.snapshot(entity)
    if storageHas<AetherSky>(ensureStorage(studio.scene),entity) {
        var sky = storageGet<AetherSky>(ensureStorage(studio.scene),entity).clone()
        sky.hour = skyClamp(parseNumber(text,sky.hour),0.0,24.0)
        storageInsert<AetherSky>(ensureStorage(studio.scene),entity,take sky)
    } else {
        var sky = storageGet<SkyEnvironment>(ensureStorage(studio.scene),entity).clone()
        sky.hour = skyClamp(parseNumber(text,sky.hour),0.0,24.0)
        storageInsert<SkyEnvironment>(ensureStorage(studio.scene),entity,take sky)
    }
    studio.skyTimeOffset = studio.editorTime.elapsedSecs
    studio.record(entity, before, studio.scene.getParent(entity).id, "edit sky hour")
}

func gizmoColors(): GizmoColors {
    var colors: GizmoColors = .()
    colors.x = studioTheme.axisX
    colors.y = studioTheme.axisY
    colors.z = studioTheme.axisZ
    colors.highlight = studioTheme.yellow
    colors.neutral = studioTheme.text
    colors.gridMinor = studioTheme.gridMinor
    colors.gridMajor = studioTheme.gridMajor
    colors.label = studioTheme.ground
    return colors
}

// ── Picking ─────────────────────────────────────────────────────────────

/** [point] taken into the space of the transform [t]. */
func intoLocal(point: Vec3&, t: Transform&): Vec3 {
    fin turned = unrotateEuler(v3sub(point, t.translation), t.rotation)
    return .(turned.x / t.scale.x, turned.y / t.scale.y, turned.z / t.scale.z)
}

/** [direction] taken into the space of the transform [t]; not renormalised, so distances stay the world's. */
func directionIntoLocal(direction: Vec3&, t: Transform&): Vec3 {
    fin turned = unrotateEuler(direction, t.rotation)
    return .(turned.x / t.scale.x, turned.y / t.scale.y, turned.z / t.scale.z)
}

/** [ray] in [entity]'s own space: through each parent's transform, then its own. */
func rayIntoEntity(world: World!, entity: Entity, ray: Ray&): Ray {
    var chain: Array<Entity> = []
    var current = entity
    var depth = 0
    while world.isAlive(current) && depth < 64 {
        chain.insert(0, current)
        current = world.getParent(current)
        depth++
    }
    var origin: Vec3 = .(ray.origin.x, ray.origin.y, ray.origin.z)
    var direction: Vec3 = .(ray.direction.x, ray.direction.y, ray.direction.z)
    for i: Int in 0..<chain.size {
        if storageHas<Transform>(ensureStorage(world), chain[i]) {
            fin t = storageGet<Transform>(ensureStorage(world), chain[i]).clone()
            origin = intoLocal(origin, t)
            direction = directionIntoLocal(direction, t)
        }
    }
    return .(origin, direction)
}

/** How far along [ray] (any length of direction) it meets a sphere of [radius] at the origin. */
func rayOriginSphere(ray: Ray&, radius: Double): Double {
    fin a = v3dot(ray.direction, ray.direction)
    fin b = v3dot(ray.origin, ray.direction)
    fin c = v3dot(ray.origin, ray.origin) - radius * radius
    fin disc = b * b - a * c
    if disc < 0.0 || a <= 0.0 then return -1.0
    fin root = sqrt(disc)
    fin near = (-b - root) / a
    if near >= 0.0 then return near
    fin far = (-b + root) / a
    return if far >= 0.0 then far else -1.0
}

/** The mesh entity the ray from ([x], [y]) meets first, or an invalid entity. */
func pickMesh(app: App!, studio: Studio!, ray: Ray&): Entity {
    var best = Entity::invalid
    var bestDistance: Double = 1000000000.0
    var index = 0
    while index < storageLength<Mesh3d>(ensureStorage(studio.scene)) {
        fin entity = storageEntityAt<Mesh3d>(ensureStorage(studio.scene), index)
        // What a World Partition streamed in is generated, not part of the scene: it is not picked.
        if studio.scene.isAlive(entity) && visibleInWorld(studio.scene, entity) && !storageHas<Streamed>(ensureStorage(studio.scene), entity) {
            fin mesh = storageValueAt<Mesh3d>(ensureStorage(studio.scene), index).clone()
            fin local = rayIntoEntity(studio.scene, entity, ray)
            fin half = mesh.size * 0.5
            fin t = when mesh.shape {
                1 -> rayOriginSphere(local, half)
                3 -> rayBox(local, .(-half, -0.02, -half), .(half, 0.02, half))
                else -> rayBox(local, .(-half, -half, -half), .(half, half, half))
            }
            if t >= 0.0 && t < bestDistance {
                bestDistance = t
                best = entity
            }
        }
        index++
    }
    index = 0
    while index < storageLength<PluginObject>(ensureStorage(studio.scene)) {
        fin entity = storageEntityAt<PluginObject>(ensureStorage(studio.scene), index)
        fin object = storageValueAt<PluginObject>(ensureStorage(studio.scene), index).clone()
        if studio.scene.isAlive(entity) && visibleInWorld(studio.scene, entity) {
            fin local = rayIntoEntity(studio.scene, entity, ray)
            fin distance = studio.pluginPick(app, object.plugin, object.id, local)
            if distance >= 0.0 && distance < bestDistance {
                bestDistance = distance
                best = entity
            }
        }
        index++
    }
    fin terrains = ensureStorage<HeightfieldTerrain>(studio.scene)
    index = 0
    while index < storageLength<HeightfieldTerrain>(terrains) {
        fin entity = storageEntityAt<HeightfieldTerrain>(terrains, index)
        if studio.scene.isAlive(entity) && visibleInWorld(studio.scene, entity) && !storageHas<Streamed>(ensureStorage(studio.scene), entity) {
            fin terrain = terrains.values[index].clone()
            fin asset = app.sceneTerrainIndex(entity,terrain,heightfieldMatrix(studio.scene,entity,terrain))
            fin data = app.gpu.terrains[asset].image.clone()
            if data.samples != 0 {
                fin local = rayIntoEntity(studio.scene, entity, ray)
                fin w = terrainClamp(terrain.width, 1.0, 100000.0)
                fin h = terrainClamp(terrain.elevation, 0.1, 10000.0)
                fin l = terrainClamp(terrain.length, 1.0, 100000.0)
                fin t = photonTerrainRay(data, .(local.origin.x/w,local.origin.y/h,local.origin.z/l),
                    Vec3(local.direction.x/w,local.direction.y/h,local.direction.z/l)).t
                if t >= 0.0 && t < bestDistance {
                    bestDistance = t
                    best = entity
                }
            }
        }
        index++
    }
    return best
}

/** A camera or light whose marker is under ([x], [y]), or an invalid entity. */
func pickMarker(studio: Studio!, viewProj: Mat4&, rect: ViewRect&, x: Double, y: Double): Entity {
    var id = 0
    while id < studio.scene.entityCount {
        fin entity = studio.scene.entityAt(id)
        if studio.scene.isAlive(entity) && (storageHas<Camera3d>(ensureStorage(studio.scene), entity) ||
            storageHas<Light3d>(ensureStorage(studio.scene), entity) ||
            storageHas<RoadPoint>(ensureStorage(studio.scene),entity) ||
            (storageHas<SplinePoint>(ensureStorage(studio.scene),entity) &&
                (studio.selected() == entity || studio.selected() == studio.scene.getParent(entity))) ||
            storageHas<RoadJunction>(ensureStorage(studio.scene),entity) ||
            storageHas<PlayerStart>(ensureStorage(studio.scene),entity)) {
            fin at = project(viewProj, rect, worldPosition(studio.scene, entity))
            if at.visible && absValue(at.x - x) < 13.0 && absValue(at.y - y) < 13.0 then return entity
        }
        id++
    }
    return ::invalid
}

// ── Pointer ─────────────────────────────────────────────────────────────

/** Applies a handle drag to the selected entity's transform. */
func applyGizmo(studio: Studio!, entity: Entity, rect: ViewRect&, input: FrameInput&) {
    var transform = Transform(.(studio.gizmoStart.translation.x, studio.gizmoStart.translation.y, studio.gizmoStart.translation.z),
        Vec3(studio.gizmoStart.rotation.x, studio.gizmoStart.rotation.y, studio.gizmoStart.rotation.z)
        Vec3(studio.gizmoStart.scale.x, studio.gizmoStart.scale.y, studio.gizmoStart.scale.z))
    when studio.gizmo.mode {
        0 -> {
            fin delta = studio.gizmo.translation(studio.camera, rect, input.x, input.y)
            transform.translation = v3add(transform.translation, delta)
        }
        1 -> {
            fin angle = studio.gizmo.rotation(studio.camera, rect, input.x, input.y)
            when studio.gizmo.active {
                1 -> { transform.rotation.x = transform.rotation.x + angle }
                2 -> { transform.rotation.y = transform.rotation.y + angle }
                else -> { transform.rotation.z = transform.rotation.z + angle }
            }
        }
        else -> {
            fin factor = studio.gizmo.scaling(studio.camera, rect, input.x, input.y)
            transform.scale = Vec3(transform.scale.x * factor.x, transform.scale.y * factor.y, transform.scale.z * factor.z)
        }
    }
    storageInsert<Transform>(ensureStorage(studio.scene), entity, take transform)
    studio.changed()
}

/** Routes a brush to the selected plugin entity, or its first visible entity. */
func brushPointer(app: App&, studio: Studio!, phase: String, ray: Ray&, seconds: Double) {
    var entity = studio.selected()
    var target: PluginObject = .()
    if studio.scene.isAlive(entity) {
        target = storageGetOrDefault<PluginObject>(ensureStorage(studio.scene), entity, .())
    }
    if target.plugin != studio.pluginToolOwner && studio.pluginHasComponents(studio.pluginToolOwner) {
        if phase == "begin" then studio.message("Select a plugin object to edit it")
        studio.pluginHit = .()
        return
    }
    if target.plugin != studio.pluginToolOwner {
        entity = Entity::invalid
        var index = 0
        while index < storageLength<PluginObject>(ensureStorage(studio.scene)) {
            fin candidate = storageEntityAt<PluginObject>(ensureStorage(studio.scene), index)
            fin item = storageValueAt<PluginObject>(ensureStorage(studio.scene), index).clone()
            if item.plugin == studio.pluginToolOwner {
                if target.plugin != studio.pluginToolOwner then target = PluginObject(item.plugin, -1, item.kind)
                if visibleInWorld(studio.scene, candidate) {
                    entity = candidate
                    target = item
                    break
                }
            }
            index++
        }
    } else if !visibleInWorld(studio.scene, entity) {
        target.id = -1
    }
    if target.id > 0 {
        fin local = rayIntoEntity(studio.scene, entity, ray)
        studio.pluginToolRequest(app, phase, ray, seconds, local, target.id, worldMatrix(studio.scene, entity))
    } else {
        studio.pluginToolRequest(app, phase, ray, seconds, ray, target.id, mat4Identity())
    }
}

/**
 * The viewport's share of this frame's pointer. Answers whether it used it.
 *
 * Right-drag looks around and, while held, W/A/S/D fly and Q/E sink and rise
 * (Shift is faster); Alt + drag orbits; middle-drag pans. On a trackpad two
 * fingers orbit (Shift pans) and a pinch zooms; a wheel zooms. In 2D every
 * drag pans and the fly keys slide the view.
 */
func viewportPointer(app: App!, studio: Studio!, rect: ViewRect&, input: FrameInput&): Bool {
    // While a game is played here the pointer is the game's: a click gives it the keyboard and mouse.
    if studio.play.running {
        if input.pressed && !studio.play.focused {
            studio.play.focused = true
            studio.changed()
        }
        return true
    }
    studio.camera.orthographic = !studio.mode3d
    fin selected = studio.selected()
    when studio.viewDrag {
        1 -> {
            // The camera is drawn every frame and no panel shows it, so moving
            // it recomposes nothing.
            if input.rightDown {
                if studio.mode3d then studio.camera.look(input.dx, input.dy) else studio.camera.pan(input.dx, input.dy, rect)
                // The wheel while flying sets the speed, as in Unreal; a trackpad's fine steps add up.
                if input.scrollY != 0.0 && studio.mode3d {
                    studio.camera.changeSpeed(if input.preciseScroll then input.scrollY / 10.0 else input.scrollY)
                    studio.cameraSpeedChanged = true
                    studio.message("Camera speed ${formatDecimal(studio.camera.speed, 1)} m/s")
                    studio.changed()
                }
                studio.camera.fly(input.flyForward, input.flyRight, input.flyUp, input.seconds, input.shift)
                return true
            }
            studio.viewDrag = 0
        }
        5 -> {
            if input.down {
                studio.camera.orbit(input.dx, input.dy)
                return true
            }
            studio.viewDrag = 0
        }
        2 -> {
            if input.rightDown || input.middleDown || input.down {
                studio.camera.pan(input.dx, input.dy, rect)
                return true
            }
            studio.viewDrag = 0
        }
        7 -> {
            if input.down && rect.contains(input.x,input.y) {
                foliagePointer(app,studio,studio.camera.ray(rect,input.x,input.y),false,true)
                return true
            }
            finishFoliageStroke(studio)
            studio.viewDrag = 0
            return true
        }
        6 -> {
            // A plugin tool's stroke, from press to release.
            fin ray = studio.camera.ray(rect, input.x, input.y)
            if input.down && rect.contains(input.x, input.y) {
                brushPointer(app, studio, "drag", ray, input.seconds)
                return true
            }
            brushPointer(app, studio, "end", ray, input.seconds)
            studio.viewDrag = 0
            return true
        }
        3 -> {
            if input.down {
                if studio.scene.isAlive(selected) then applyGizmo(studio, selected, rect, input)
                return true
            }
            studio.gizmo.end()
            studio.viewDrag = 0
            if studio.scene.isAlive(selected) {
                studio.record(selected, studio.gizmoBefore, studio.scene.getParent(selected).id,
                    when studio.gizmo.mode {
                        0 -> "move"
                        1 -> "rotate"
                        else -> "scale"
                    })
            }
            return true
        }
        else -> { }
    }
    if !rect.contains(input.x, input.y) then return false
    if input.pinch != 0.0 then studio.camera.zoom(input.pinch * 6.0)
    if input.scrollX != 0.0 || input.scrollY != 0.0 {
        when {
            !input.preciseScroll -> studio.camera.zoom(input.scrollY * 0.35)
            input.shift || !studio.mode3d -> studio.camera.pan(input.scrollX, input.scrollY, rect)
            else -> studio.camera.orbit(input.scrollX, input.scrollY)
        }
    }
    fin hasHandles = studio.foliageBrush.mode == 0 && studio.pluginTool == "" && studio.tool != 0 && studio.scene.isAlive(selected)
    if hasHandles {
        studio.gizmo.mode = studio.tool - 1
        studio.gizmo.origin = worldPosition(studio.scene, selected)
        fin hover = studio.gizmo.pick(studio.camera, rect, input.x, input.y)
        if hover != studio.gizmo.hover then studio.gizmo.hover = hover
    }
    if studio.tracing && (input.pressed || input.released) {
        fin at = project(studio.camera.viewProj(rect.aspect()), rect, studio.gizmo.origin)
        println("viewport rect ${formatDecimal(rect.x, 0)},${formatDecimal(rect.y, 0)} ${formatDecimal(rect.width, 0)}x${formatDecimal(rect.height, 0)} tool ${studio.tool} selected ${selected.id} handles ${hasHandles} hover ${studio.gizmo.hover} gizmo at ${formatDecimal(at.x, 0)},${formatDecimal(at.y, 0)}")
    }
    if input.rightPressed {
        studio.viewDrag = 1
        return true
    }
    if input.middlePressed {
        studio.viewDrag = 2
        return true
    }
    if studio.foliageBrush.mode > 0 && studio.mode3d && !input.alt {
        foliagePointer(app,studio,studio.camera.ray(rect,input.x,input.y),input.pressed,false)
        if input.pressed {
            studio.viewDrag = 7
            return true
        }
        return false
    }
    if studio.roadPlacement > 0 && input.pressed && !input.alt {
        placeOnTerrain(app,studio,studio.camera.ray(rect,input.x,input.y))
        return true
    }
    // A plugin tool in hand answers the pointer before picking does.
    if studio.pluginTool != "" && !input.alt {
        fin ray = studio.camera.ray(rect, input.x, input.y)
        if input.pressed {
            brushPointer(app, studio, "begin", ray, input.seconds)
            studio.viewDrag = 6
            return true
        }
        brushPointer(app, studio, "hover", ray, input.seconds)
        return false
    }
    if !input.pressed then return false
    if input.alt {
        studio.viewDrag = if studio.mode3d then 5 else 2
        return true
    }
    fin axis = orientationPick(studio.camera, rect, input.x, input.y)
    if axis != 0 && studio.mode3d {
        studio.camera.lookAlong(axis - 1, true)
        studio.changed()
        return true
    }
    if hasHandles && studio.gizmo.hover != 0 {
        studio.gizmoBefore = studio.snapshot(selected)
        studio.gizmoStart = storageGetOrDefault<Transform>(ensureStorage(studio.scene), selected, .())
        studio.gizmo.begin(studio.gizmo.hover, studio.camera, rect, input.x, input.y)
        studio.viewDrag = 3
        return true
    }
    fin viewProj = studio.camera.viewProj(rect.aspect())
    var hit = pickMarker(studio, viewProj, rect, input.x, input.y)
    if !studio.scene.isAlive(hit) then hit = pickMesh(app, studio, studio.camera.ray(rect, input.x, input.y))
    studio.select(hit)
    if studio.scene.isAlive(hit) { studio.message("Selected ${studio.nameOf(hit)}") }
    return true
}

// ── Drawing ─────────────────────────────────────────────────────────────

/** The corners of [entity]'s mesh bounds, in the world. */
func boundsLines(app: App!, studio: Studio!, entity: Entity, viewProj: Mat4&, rect: ViewRect&, color: Rgba) {
    if !storageHas<Mesh3d>(ensureStorage(studio.scene), entity) then return
    fin mesh = storageGet<Mesh3d>(ensureStorage(studio.scene), entity).clone()
    fin m = worldMatrix(studio.scene, entity)
    fin half = mesh.size * 0.5
    fin flat = mesh.shape == 3
    fin low = if flat then 0.0 else -half
    fin high = if flat then 0.0 else half
    var corners: Array<Vec3> = []
    for i: Int in 0..<8 {
        fin x = if i % 2 == 0 then -half else half
        fin y = if (i / 2) % 2 == 0 then low else high
        fin z = if i / 4 == 0 then -half else half
        corners.add(Vec3(m.m00 * x + m.m01 * y + m.m02 * z + m.m03, m.m10 * x + m.m11 * y + m.m12 * z + m.m13, m.m20 * x + m.m21 * y + m.m22 * z + m.m23))
    }
    fin edges = [0, 1, 2, 3, 4, 5, 6, 7, 0, 2, 1, 3, 4, 6, 5, 7, 0, 4, 1, 5, 2, 6, 3, 7]
    var edge = 0
    while edge < edges.size {
        app.worldLine(viewProj, rect, corners[edges[edge]], corners[edges[edge + 1]], 1.5, color)
        edge += 2
    }
}

/**
 * A marker for each camera and light (a disc with its glyph, and which way it
 * faces), a dot for each junction and player start, and for the knots of the
 * road being edited. Only the storages that carry markers are walked, and what
 * a World Partition streamed in has none.
 */
func drawMarkers(app: App!, studio: Studio!, viewProj: Mat4&, rect: ViewRect&) {
    fin streamed = ensureStorage<Streamed>(studio.scene)
    fin junctions = ensureStorage<RoadJunction>(studio.scene)
    for i: Int in 0..<storageLength<RoadJunction>(junctions) {
        fin entity = storageEntityAt<RoadJunction>(junctions, i)
        if !storageHas<Streamed>(streamed, entity) then markerDot(app, studio, viewProj, rect, entity, studioTheme.accent)
    }
    fin starts = ensureStorage<PlayerStart>(studio.scene)
    for i: Int in 0..<storageLength<PlayerStart>(starts) {
        fin entity = storageEntityAt<PlayerStart>(starts, i)
        if !storageHas<Streamed>(streamed, entity) then markerDot(app, studio, viewProj, rect, entity, studioTheme.green)
    }
    fin selected = studio.selected()
    if studio.scene.isAlive(selected) {
        fin owner = if storageHas<SplinePoint>(ensureStorage(studio.scene), selected)
            then studio.scene.getParent(selected) else selected.clone()
        fin splines = ensureStorage<FlightSpline>(studio.scene)
        if storageHas<FlightSpline>(splines, owner) {
            fin closed = storageGet<FlightSpline>(splines, owner).closed
            fin knots = flightKnots(studio.scene, owner)
            fin curve = flightPolyline(knots, closed)
            for i: Int in 1..<curve.size {
                app.worldLine(viewProj, rect, curve[i-1], curve[i], 2.0, studioTheme.teal.withAlpha(0.85))
            }
            fin controls = ensureStorage<SplinePoint>(studio.scene)
            for i: Int in 0..<storageLength<SplinePoint>(controls) {
                fin point = storageEntityAt<SplinePoint>(controls, i)
                if studio.scene.getParent(point) == owner then markerDot(app, studio, viewProj, rect, point, studioTheme.teal)
            }
        }
    }
    fin points = ensureStorage<RoadPoint>(studio.scene)
    for i: Int in 0..<storageLength<RoadPoint>(points) {
        fin entity = storageEntityAt<RoadPoint>(points, i)
        fin road = studio.scene.getParent(entity)
        if selected == entity || selected == road || (studio.roadPlacement == 1 && studio.roadTarget == road) {
            markerDot(app, studio, viewProj, rect, entity, studioTheme.accent)
        }
    }
    fin cameras = ensureStorage<Camera3d>(studio.scene)
    for i: Int in 0..<storageLength<Camera3d>(cameras) {
        fin entity = storageEntityAt<Camera3d>(cameras, i)
        if !storageHas<Streamed>(streamed, entity) then markerGlyph(app, studio, viewProj, rect, entity, true)
    }
    fin sky = sceneSkyLight(studio.scene)
    fin lights = ensureStorage<Light3d>(studio.scene)
    for i: Int in 0..<storageLength<Light3d>(lights) {
        fin entity = storageEntityAt<Light3d>(lights, i)
        if entity != sky && !storageHas<Streamed>(streamed, entity) then markerGlyph(app, studio, viewProj, rect, entity, false)
    }
}

/** A small dot at [entity]. */
func markerDot(app: App!, studio: Studio!, viewProj: Mat4&, rect: ViewRect&, entity: Entity, tint: Rgba) {
    if !studio.scene.isAlive(entity) then return
    fin at = project(viewProj,rect,worldPosition(studio.scene,entity))
    if at.visible then app.uiRoundRect(at.x-4.0,at.y-4.0,8.0,8.0,4.0,tint.r,tint.g,tint.b,0.9)
}

/** A camera's or a light's disc with its glyph, and a line the way it faces. */
func markerGlyph(app: App!, studio: Studio!, viewProj: Mat4&, rect: ViewRect&, entity: Entity, camera: Bool) {
    if !studio.scene.isAlive(entity) then return
    fin position = worldPosition(studio.scene, entity)
    fin m = worldMatrix(studio.scene, entity)
    fin facing = v3unit(.(-m.m02, -m.m12, -m.m22))
    fin tint = if camera then studioTheme.teal else studioTheme.yellow
    fin selected = storageHas<Selected>(ensureStorage(studio.scene), entity)
    app.worldLine(viewProj, rect, position, v3add(position, v3scale(facing, if camera then 1.2 else 1.6)), if selected then 2.0 else { 1.5 }, tint.withAlpha(0.85))
    fin at = project(viewProj, rect, position)
    if at.visible {
        app.uiRoundRect(at.x - 11.0, at.y - 11.0, 22.0, 22.0, 11.0, studioTheme.ground.r, studioTheme.ground.g, studioTheme.ground.b, 0.85)
        app.uiRoundRectStroke(at.x - 11.0, at.y - 11.0, 22.0, 22.0, 11.0, if selected then 2.0 else 1.5, tint.r, tint.g, tint.b, 1.0)
        app.drawIcon(studio.icons, if camera then "video" else "sun", at.x - studioTheme.iconSmall * 0.5, at.y - studioTheme.iconSmall * 0.5, studioTheme.iconSmall, tint)
    }
}

/** Reuses the authored camera for heightfield scenes so the terrain opens framed. */
func frameTerrainScene(studio: Studio!) {
    // A World Partition's ground streams in around the camera: it opens where the authored camera looks too.
    fin streamedWorld = worldPartitionEntity(studio.scene).isValid
    if storageLength<HeightfieldTerrain>(ensureStorage(studio.scene)) == 0 && !streamedWorld then return
    fin cameras = ensureStorage<Camera3d>(studio.scene)
    var index = 0
    while index < storageLength<Camera3d>(cameras) {
        fin entity = storageEntityAt<Camera3d>(cameras, index)
        if studio.scene.isAlive(entity) && cameras.values[index].active {
            fin camera = cameras.values[index].clone()
            fin pose = worldMatrix(studio.scene, entity)
            fin forward = v3unit(.(-pose.m02, -pose.m12, -pose.m22))
            fin eye: Vec3 = .(pose.m03, pose.m13, pose.m23)
            if storageLength<HeightfieldTerrain>(ensureStorage(studio.scene)) > 0 {
                fin terrain = storageValueAt<HeightfieldTerrain>(ensureStorage(studio.scene), 0).clone()
                studio.camera.distance = (terrain.width + terrain.length) * 0.15
            } else {
                studio.camera.distance = streamedViewDistance
            }
            studio.camera.target = v3add(eye, v3scale(forward, studio.camera.distance))
            studio.camera.pitch = asin(clampValue(forward.y, -1.0, 1.0)) / degreesToRadians
            studio.camera.yaw = atan2(-forward.x, -forward.z) / degreesToRadians
            studio.camera.fov = camera.fov
            studio.camera.near = camera.near
            studio.camera.far = camera.far
            return
        }
        index++
    }
}

/** How far ahead of a streamed world's authored camera the editor camera orbits when a scene opens, in metres. */
inline fin streamedViewDistance: Double = 400.0

/** A count as people read it: 980, 48.2k, 1.4M. */
func countText(count: Int): String = when {
    count >= 1000000 -> "${fixedDecimal((count as Double)/1000000.0,1)}M"
    count >= 1000 -> "${fixedDecimal((count as Double)/1000.0,1)}k"
    else -> "${count}"
}

func drawViewport(app: App!, studio: Studio!, rect: ViewRect&) {
    if rect.width < 4.0 || rect.height < 4.0 then return
    // Play In Editor: the game's frames instead of the editor's view.
    if studio.play.running {
        app.setScissor(rect.x, rect.y, rect.width, rect.height)
        drawPlayFrame(app, studio, rect.x, rect.y, rect.width, rect.height)
        app.clearScissor()
        return
    }
    if studio.pauseViewportDuringPlay && studio.process != 0 && studio.processAction == "play" && !studio.handingOver {
        fin label = "Viewport paused while the game runs"
        app.setScissor(rect.x, rect.y, rect.width, rect.height)
        app.uiTextColored(label, rect.x + (rect.width - app.uiTextWidth(label, 13.0)) * 0.5,
            rect.y + (rect.height - app.uiTextHeight(13.0)) * 0.5, 13.0,
            studioTheme.muted.r, studioTheme.muted.g, studioTheme.muted.b)
        app.clearScissor()
        return
    }
    studio.camera.orthographic = !studio.mode3d
    // A World Partition streams its cells around the editor's view, as around the player in a game.
    // A cell that came in or went changes what the Scene Tree lists.
    if streamWorldAround(studio.scene, studio.root, studio.camera.position()) > 0 then studio.changed()
    fin colors = gizmoColors()
    fin viewProj = studio.camera.viewProj(rect.aspect())
    app.setScissor(rect.x, rect.y, rect.width, rect.height)
    fin firstFrame = studio.editorFrames == 0
    fin delta = if studio.viewportSimulations && !firstFrame then clampValue(app.deltaTime(), 0.0, 0.1) else 0.0
    if delta > 0.0 then studio.editorTime.advance(delta)
    fin skyTime = studio.editorTime.elapsedSecs - studio.skyTimeOffset
    fin quality = studio.viewportQuality
    fin lit = studio.viewMode == 0
    fin cinematic = lit && quality == .Ultra
    fin upscale = app.gpu.upscale
    fin upscaleFactor = app.gpu.upscaleFactor
    fin nativeTemporal = app.gpu.nativeTemporal
    fin filmGrade = app.gpu.filmGrade
    fin sharpness = app.gpu.resolveSharpness
    fin reflectWater = app.gpu.reflectWater
    fin offscreen = app.gpu.offscreenScene
    fin detailOnly = app.gpu.detailShadowsOnly
    app.gpu.upscale = studio.viewMode != 2 && studio.viewportUpscaling
    app.gpu.upscaleFactor = if quality == .Low then 0.375 else 0.5
    app.gpu.nativeTemporal = cinematic && !app.gpu.upscale
    app.gpu.filmGrade = if cinematic then 1.4 else 0.0
    app.gpu.resolveSharpness = if cinematic then 0.3 else 0.0
    app.gpu.reflectWater = cinematic && studio.mode3d
    fin water = studio.mode3d && (storageLength<Ocean>(ensureStorage(studio.scene)) > 0 ||
        storageLength<WaterSurface>(ensureStorage(studio.scene)) > 0)
    app.gpu.offscreenScene = water
    app.beginScenePass()
    // The engine's editor systems on the edited scene, as the game runs them: its weather, water, plants and roads.
    if studio.editorMatrices == 0 then studio.editorMatrices = azAlloc(sceneViewMatrixBytes)
    var overlay = Composition::of(studio.editorUi, "editor-systems")
    var frame: Game = .(studio.scene, app, overlay, studio.editorAudio)
    frame.camera = studio.camera.clone()
    frame.time.elapsedSecs = studio.editorTime.elapsedSecs
    frame.time.deltaSecs = delta
    frame.time.frame = studio.editorTime.frame
    frame.time.editing = true
    frame.paused = !studio.viewportSimulations && !firstFrame
    frame.view.matrices = studio.editorMatrices
    frame.view.frame = studio.editorFrames
    updateSceneView(frame, viewProj, rect)
    studio.editorFrames = frame.view.frame
    if firstFrame then dispatchEditor(studio.systems, .Startup, frame)
    dispatchEditor(studio.systems, .PreUpdate, frame, paused: frame.paused)
    dispatchEditor(studio.systems, .Update, frame, paused: frame.paused)
    dispatchEditor(studio.systems, .PostUpdate, frame, paused: frame.paused)
    fin skyEntity = sceneSkyLight(studio.scene)
    fin drawnSky = drawPhysicalSky(app,studio,rect,skyTime)
    if !drawnSky && studio.mode3d && studio.scene.isAlive(skyEntity) {
        fin sky = sampleSky(storageGet<SkyEnvironment>(ensureStorage(studio.scene), skyEntity), skyTime)
        app.drawSkyView(rect.x, rect.y, rect.width, rect.height, sky,
            studio.camera.forward(), studio.camera.right(), studio.camera.up(), tan(studio.camera.fov*degreesToRadians*0.5))
    } else if !drawnSky {
        app.drawGrid(studio.camera, rect, 1.0, 40.0, colors)
    }
    app.beginView(viewProj, rect)
    app.setMaterialEye(studio.camera.position())
    app.gpu.flatMaterials = !lit
    app.gpu.shadowsActive = false
    app.gpu.indirectLighting = lit && (quality == .High || quality == .Ultra)
    app.gpu.virtualShadows = quality != .Medium
    app.gpu.detailShadowsOnly = quality == .Low
    if lit {
        if studio.recomputeShadows {
            discardStaticShadows(app.gpu)
            studio.recomputeShadows = false
        }
        app.applySceneLight(studio.scene, skyTime)
        if quality == .Low then app.gpu.cloudShadow = 0
        fin distance = clampValue(studio.camera.distance, 0.0, app.gpu.detailHalf * 0.75)
        fin focus = v3add(studio.camera.position(), v3scale(studio.camera.forward(), distance))
        app.updateScenePhotons(studio.scene, focus, skyTime, previewIndirect: cinematic)
    } else {
        app.setAmbientLight(1.0)
    }
    if studio.viewMode == 2 then send1(app.gpu.enc, sel("setTriangleFillMode:"), 1)
    // The built-in scene with the editor systems' shadow casters and opaque draws, as in the game.
    app.prepareSceneDraw(studio.scene)
    var cascade = app.beginSunCascade()
    if cascade.open {
        app.drawSceneCasters(studio.scene, studio.meshes)
        dispatchEditor(studio.systems, .RenderShadow, frame)
        app.endSunCascade(cascade)
    }
    app.drawSceneOpaque(studio.scene, studio.meshes, false)
    frame.view.encoder = app.gpu.enc
    dispatchEditor(studio.systems, .RenderOpaque, frame)
    app.gpu.mode = -1
    app.gpu.meshPipeline = 0
    app.drawPluginMeshes(studio, rect)
    if studio.viewMode == 2 then send1(app.gpu.enc, sel("setTriangleFillMode:"), 0)
    app.gpu.flatMaterials = false
    if studio.tracing && studio.editorFrames == 1 {
        fin seas = ensureStorage<SeaGpu>(studio.scene)
        fin simulated = if storageLength<SeaGpu>(seas) > 0 then seas.values[0].revision else -1
        println("viewport ${studio.scenePath}: waves=${simulated}, shadows=${app.gpu.shadowsActive}, cascade=${app.gpu.detailReady}, atlas=${app.gpu.staticShadowReady}, pages=${app.gpu.photonPages}")
    }
    if water && app.gpu.scenePass.active {
        app.suspendScenePass()
        frame.view.encoder = 0
        dispatchEditor(studio.systems, .RenderVolumes, frame)
    }
    app.endView()
    app.gpu.upscale = upscale
    app.gpu.upscaleFactor = upscaleFactor
    app.gpu.nativeTemporal = nativeTemporal
    app.gpu.filmGrade = filmGrade
    app.gpu.resolveSharpness = sharpness
    app.gpu.reflectWater = reflectWater
    app.gpu.offscreenScene = offscreen
    app.gpu.detailShadowsOnly = detailOnly
    app.setScissor(rect.x, rect.y, rect.width, rect.height)
    fin selected = studio.selected()
    if studio.scene.isAlive(selected) then boundsLines(app, studio, selected, viewProj, rect, studioTheme.accent.withAlpha(0.9))
    drawMarkers(app, studio, viewProj, rect)
    app.drawPluginBrush(studio, viewProj, rect, studioTheme.accent)
    drawFoliageBrush(app,studio,viewProj,rect)
    if studio.foliageBrush.mode == 0 && studio.pluginTool == "" && studio.tool != 0 && studio.scene.isAlive(selected) {
        studio.gizmo.mode = studio.tool - 1
        if studio.gizmo.active == 0 then studio.gizmo.origin = worldPosition(studio.scene, selected)
        app.drawGizmo(studio.gizmo, studio.camera, rect, colors)
    }
    if studio.mode3d then app.drawOrientation(studio.camera, rect, colors, 0)
    // Frame rate and frame time beside the axis widget, with what the terrain and plugin meshes cost.
    fin triangles = app.gpu.terrainTriangles + studio.pluginTriangles
    fin detail = if triangles > 0 then "${countText(triangles)} terrain tris" else ""
    app.drawFrameStats(studio.frameStats, rect.x + rect.width - (if studio.mode3d then 92.0 else 10.0), rect.y + 10.0, detail)
    fin label = if studio.mode3d then "Perspective" else "2D · Orthographic"
    fin width = app.uiTextWidth(label, 11.0) + 18.0
    app.uiRoundRect(rect.x + 10.0, rect.y + 10.0, width, 22.0, 11.0, 0.0, 0.0, 0.0, 0.35)
    app.uiTextColored(label, rect.x + 19.0, rect.y + 10.0 + (22.0 - app.uiTextHeight(11.0)) * 0.5, 11.0, studioTheme.muted.r, studioTheme.muted.g, studioTheme.muted.b)
    app.clearScissor()
}
